@@ -59,11 +59,18 @@ void CompanionSerial::loop()
 
         switch (state_) {
         case IDLE:
+#if defined(RAUMATA_COMPANION_MODE_BLE_USB) && RAUMATA_COMPANION_MODE_BLE_USB
+            // USB belongs to MeshCore. A Meshtastic frame must not flip the port.
+            if (c == '<') {
+                state_ = MESHCORE_LEN1;
+            }
+#else
             if (c == 0x94) {
