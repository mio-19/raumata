diff --git a/src/raumata/MeshCoreRadio.cpp b/src/raumata/MeshCoreRadio.cpp
index dc94ac3abc6a1fbe24be22431ff6dba307eb88a9..53f3bfe80011c34b9eae6c9f27c1694959fa717e 100644
--- a/src/raumata/MeshCoreRadio.cpp
+++ b/src/raumata/MeshCoreRadio.cpp
@@ -80,19 +80,21 @@ float MeshCoreRadio::packetScore(float snr, int packet_len)
 
 bool MeshCoreRadio::startSendRaw(const uint8_t *bytes, int len)
 {
-    if (len <= 0 || len > MAX_TRANS_UNIT || pendingLen_ != 0 || sending_) {
+    const size_t framed = static_cast<size_t>(kMagicLen) + static_cast<size_t>(len);
+    if (len <= 0 || len > MAX_TRANS_UNIT || framed > MAX_LORA_PAYLOAD_LEN || pendingLen_ != 0 || sending_) {
         return false;
     }
 
-    pendingLen_ = static_cast<uint16_t>(kMagicLen + len);
+    pendingLen_ = static_cast<uint16_t>(framed);
     memcpy(pending_, kMagic, kMagicLen);
     memcpy(pending_ + kMagicLen, bytes, len);
 
     if (radio_.rawTransmit(pending_, pendingLen_)) {
         pendingLen_ = 0;
         sending_ = true;
+        txCount_++;
     } else {
-        // The Meshtastic stack is using the radio.  Keep the frame and let
+        // The Meshtastic stack is using the radio. Keep the frame and let
         // loop() retry; report success so MeshCore does not free it.
         sending_ = false;
     }
@@ -124,6 +126,20 @@ bool MeshCoreRadio::isSendComplete()
 
 void MeshCoreRadio::onSendFinished()
 {
+    if (pendingLen_ != 0 && !sending_) {
+        // Dispatcher timed out before the radio was free. Drop the frame so
+        // the next send is not stuck behind it.
+        pendingLen_ = 0;
+        return;
+    }
+    if (!sending_) {
+        return;
+    }
+    if (!radio_.rawTransmitDone()) {
+        // The airtime estimate expired while the chip is still transmitting.
+        // loop() finishes the radio operation after the interrupt.
+        return;
+    }
     radio_.rawTransmitFinished();
     sending_ = false;
 }
@@ -142,6 +158,10 @@ bool MeshCoreRadio::isReceiving()
 
 void MeshCoreRadio::loop()
 {
+    if (sending_ && radio_.rawTransmitDone()) {
+        radio_.rawTransmitFinished();
+        sending_ = false;
+    }
     tryStartPending();
 }
 
