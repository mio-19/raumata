-bool meshtasticPacketMayTransmit(uint8_t portnum, uint8_t priority, uint32_t estAirtimeMs)
+constexpr int32_t kPortStampBase = 30000;
+
+void rememberMeshtasticPort(meshtastic_MeshPacket *packet)
+{
+    if (!packet || packet->which_payload_variant != meshtastic_MeshPacket_decoded_tag) {
+        return;
+    }
+    int port = static_cast<int>(packet->decoded.portnum);
+    if (port < 0 || port > 511) {
+        port = 0;
+    }
+    packet->rx_rssi = kPortStampBase + port;
+}
+
+bool meshtasticPacketMayTransmit(const meshtastic_MeshPacket *packet, uint32_t estAirtimeMs)
 {
-    const bool essential = portnum == meshtastic_PortNum_TEXT_MESSAGE_APP ||
-                           portnum == meshtastic_PortNum_ROUTING_APP || portnum == meshtastic_PortNum_ADMIN_APP;
-    if (essential) {
+    uint8_t portnum = 0;
+    uint8_t priority = packet ? packet->priority : 0;
+    bool portKnown = false;
+    if (packet && packet->rx_rssi >= kPortStampBase && packet->rx_rssi < kPortStampBase + 512) {
+        portnum = static_cast<uint8_t>(packet->rx_rssi - kPortStampBase);
+        portKnown = true;
+    }
+
+    if (portKnown && (portnum == meshtastic_PortNum_TEXT_MESSAGE_APP || portnum == meshtastic_PortNum_ROUTING_APP ||
+                      portnum == meshtastic_PortNum_ADMIN_APP)) {
         return true;
     }
 
-    const bool presenceTraffic = portnum == meshtastic_PortNum_NODEINFO_APP ||
-                                 portnum == meshtastic_PortNum_POSITION_APP ||
-                                 portnum == meshtastic_PortNum_TELEMETRY_APP ||
-                                 priority < meshtastic_MeshPacket_Priority_DEFAULT;
+    const bool presenceTraffic =
+        (portKnown && (portnum == meshtastic_PortNum_NODEINFO_APP || portnum == meshtastic_PortNum_POSITION_APP ||
+                       portnum == meshtastic_PortNum_TELEMETRY_APP)) ||
+        priority < meshtastic_MeshPacket_Priority_DEFAULT;
     if (!meshtasticPresenceEnabled() && presenceTraffic) {
         return false;
     }
@@ -328,16 +351,18 @@ bool applyOperatingMode(OperatingMode mode)
         return false;
     }
 
-    const bool changed = gMode != mode;
+    const OperatingMode previous = gMode;
     gMode = mode;
-    saveModeToNvs();
 
     if (!profileKindAllowed(static_cast<uint8_t>(activePhyProfile().kind))) {
-        return applyPhyProfile(defaultProfileIdForMode(mode));
-    }
-    if (changed) {
+        if (!applyPhyProfile(defaultProfileIdForMode(mode))) {
+            gMode = previous;
+            return false;
+        }
+    } else if (previous != mode) {
         notifyOperatingModeChanged();
     }
+    saveModeToNvs();
     return true;
 }
 
