     (void)len;
 }
 
+int MeshCoreNode::getBlobByKey(const uint8_t key[], int keyLen, uint8_t destBuf[])
+{
+    if (keyLen <= 0 || keyLen > PUB_KEY_SIZE) {
+        return 0;
+    }
+    for (size_t i = 0; i < MAX_CONTACTS; ++i) {
+        if (contactBlobs_[i].active && memcmp(contactBlobs_[i].key, key, keyLen) == 0) {
+            memcpy(destBuf, contactBlobs_[i].data, contactBlobs_[i].len);
+            return contactBlobs_[i].len;
+        }
+    }
+    return 0;
+}
+
+bool MeshCoreNode::putBlobByKey(const uint8_t key[], int keyLen, const uint8_t srcBuf[], int len)
+{
+    if (keyLen <= 0 || keyLen > PUB_KEY_SIZE || len <= 0 || len > MAX_TRANS_UNIT) {
+        return false;
+    }
+    for (size_t i = 0; i < MAX_CONTACTS; ++i) {
+        if (contactBlobs_[i].active && memcmp(contactBlobs_[i].key, key, keyLen) == 0) {
+            memcpy(contactBlobs_[i].data, srcBuf, len);
+            contactBlobs_[i].len = static_cast<uint8_t>(len);
+            return true;
+        }
+    }
+    for (size_t i = 0; i < MAX_CONTACTS; ++i) {
+        if (!contactBlobs_[i].active) {
+            memset(contactBlobs_[i].key, 0, PUB_KEY_SIZE);
+            memcpy(contactBlobs_[i].key, key, keyLen);
+            memcpy(contactBlobs_[i].data, srcBuf, len);
+            contactBlobs_[i].len = static_cast<uint8_t>(len);
+            contactBlobs_[i].active = true;
+            return true;
+        }
+    }
+    size_t idx = nextBlobIdx_ % MAX_CONTACTS;
+    nextBlobIdx_ = static_cast<uint8_t>((idx + 1) % MAX_CONTACTS);
+    memset(contactBlobs_[idx].key, 0, PUB_KEY_SIZE);
+    memcpy(contactBlobs_[idx].key, key, keyLen);
+    memcpy(contactBlobs_[idx].data, srcBuf, len);
+    contactBlobs_[idx].len = static_cast<uint8_t>(len);
+    contactBlobs_[idx].active = true;
+    return true;
+}
+
