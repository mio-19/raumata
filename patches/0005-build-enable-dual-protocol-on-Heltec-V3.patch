From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Fri, 23 Oct 2026 11:07:11 +1100
Subject: [PATCH] build: enable dual protocol on Heltec V3

Add the heltec-v3-dual PlatformIO environment with RAUMATA_DUAL_PROTOCOL, RAUMATA_COMPANION_MODE_BLE_USB, the vendored MeshCore headers, and the Crypto/base64 dependencies.

diff --git a/variants/esp32s3/heltec_v3/platformio.ini b/variants/esp32s3/heltec_v3/platformio.ini
index 2f53c87563f741fbfb0dc4c55010a70001e5ba88..cbaabf3952bf5d6f8427a1a46a447030fc4bbc3f 100644
--- a/variants/esp32s3/heltec_v3/platformio.ini
+++ b/variants/esp32s3/heltec_v3/platformio.ini
@@ -18,3 +18,21 @@ build_flags =
   ${esp32s3_base.build_flags}
   -D HELTEC_V3
   -I variants/esp32s3/heltec_v3
+
+; Raumata dual-protocol firmware: Meshtastic + MeshCore on one SX1262.
+; MeshCore and Meshtastic share one selectable PHY profile; frames are
+; distinguished on air by the RAUM transport tag.
+[env:heltec-v3-dual]
+extends = env:heltec-v3
+build_flags =
+  ${env:heltec-v3.build_flags}
+  -D RAUMATA_DUAL_PROTOCOL=1
+  -D RAUMATA_COMPANION_MODE_BLE_USB=1
+  -D MAX_CONTACTS=32
+  -D MAX_GROUP_CHANNELS=8
+  -I lib/meshcore/src
+  -I lib/meshcore/src/ed25519
+lib_deps =
+  ${env:heltec-v3.lib_deps}
+  rweather/Crypto @ ^0.4.0
+  densaugeo/base64 @ ~1.4.0
