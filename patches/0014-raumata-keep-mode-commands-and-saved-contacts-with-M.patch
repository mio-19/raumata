From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mio <mio@mio19.uk>
Date: Sat, 24 Oct 2026 16:18:50 +1100
Subject: [PATCH] raumata: keep mode commands and saved contacts with MyMesh

The companion CLI again accepts mode, phy, and link, and a radio change still has to match the operating mode. Contacts and channels saved by the previous node are copied into the companion store once.

Co-authored-by: Cursor <cursoragent@cursor.com>

diff --git a/src/raumata/RaumataProtocol.cpp b/src/raumata/RaumataProtocol.cpp
index 93db49183c33cc8786af67d6c42712a0dd841d80..e47ab588626b5f032cb348e87d623f6aafa9976d 100644
--- a/src/raumata/RaumataProtocol.cpp
+++ b/src/raumata/RaumataProtocol.cpp
@@ -163,6 +163,44 @@ void adoptLegacyCompanionState(MyMesh &mesh)
         }
         prefs.end();
     }
+
+    Preferences legacy;
+    bool imported = false;
+    if (legacy.begin("raumata", false)) {
+        size_t contactLen = legacy.getBytesLength("mc_contacts");
+        if (contactLen > 0 && contactLen % sizeof(ContactInfo) == 0 &&
+            contactLen <= sizeof(ContactInfo) * MAX_CONTACTS) {
+            size_t count = contactLen / sizeof(ContactInfo);
+            ContactInfo saved[MAX_CONTACTS];
+            if (legacy.getBytes("mc_contacts", saved, contactLen) == contactLen) {
+                for (size_t i = 0; i < count; i++) {
+                    if (saved[i].type != 0 && saved[i].name[0] != 0) {
+                        mesh.importLegacyContact(saved[i]);
+                        imported = true;
+                    }
+                }
+                legacy.remove("mc_contacts");
+            }
+        }
+        size_t channelLen = legacy.getBytesLength("mc_ch");
+        if (channelLen == sizeof(ChannelDetails) * MAX_GROUP_CHANNELS) {
+            ChannelDetails channels[MAX_GROUP_CHANNELS];
+            if (legacy.getBytes("mc_ch", channels, channelLen) == channelLen) {
+                for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+                    if (channels[i].name[0]) {
+                        mesh.importLegacyChannel(static_cast<uint8_t>(i), channels[i]);
+                        imported = true;
+                    }
+                }
+                legacy.remove("mc_ch");
+            }
+        }
+        legacy.end();
+    }
+    if (imported) {
+        mesh.saveImportedState();
+    }
+
     if (changed) {
         mesh.savePrefs();
     }
diff --git a/src/raumata/companion/CompanionHooks.cpp b/src/raumata/companion/CompanionHooks.cpp
index 76513f27dd7e2fcfa5d3d3957f622f60c57002c3..b2924bb31bc88512363c8cfe56b355fd76e3b65b 100644
--- a/src/raumata/companion/CompanionHooks.cpp
+++ b/src/raumata/companion/CompanionHooks.cpp
@@ -256,6 +256,54 @@ bool handleCompanionExtension(const uint8_t *frame, size_t len, BaseSerialInterf
     return true;
 }
 
+int handleCompanionCli(const char *command, char *reply, size_t replySize)
+{
+    if (!command || !reply || replySize == 0) {
+        return 0;
+    }
+
+    if (strcmp(command, "link") == 0) {
+        formatLinkSummary(reply, replySize);
+        return 1;
+    }
+    if (handleModeCliCommand(command, reply, replySize)) {
+        return strncmp(command, "mode set", 8) == 0 ? 2 : 1;
+    }
+    if (handlePhyCliCommand(command, reply, replySize)) {
+        return strncmp(command, "phy set", 7) == 0 ? 2 : 1;
+    }
+
+    if (strcmp(command, "get af") == 0 || strcmp(command, "get dutycycle") == 0) {
+        snprintf(reply, replySize, "mode %s mc_share=%.0f%%", operatingModeName(activeOperatingMode()),
+                 meshCoreAirtimeShare() * 100.0f);
+        return 1;
+    }
+    if (strncmp(command, "set af", 6) == 0 || strncmp(command, "set dutycycle", 13) == 0) {
+        snprintf(reply, replySize, "airtime share follows the operating mode; use mode set");
+        return 1;
+    }
+
+    if (strncmp(command, "set radio ", 10) != 0) {
+        return 0;
+    }
+
+    char tmp[132];
+    strncpy(tmp, command + 10, sizeof(tmp) - 1);
+    tmp[sizeof(tmp) - 1] = 0;
+    const char *parts[4];
+    int num = mesh::Utils::parseTextParts(tmp, parts, 4);
+    float freq = num > 0 ? strtof(parts[0], nullptr) : 0.0f;
+    float bw = num > 1 ? strtof(parts[1], nullptr) : 0.0f;
+    uint8_t sf = num > 2 ? static_cast<uint8_t>(atoi(parts[2])) : 0;
+    uint8_t cr = num > 3 ? static_cast<uint8_t>(atoi(parts[3])) : 0;
+    if (acceptCompanionRadio(freq, bw, sf, cr)) {
+        snprintf(reply, replySize, "OK");
+        return 2;
+    }
+    snprintf(reply, replySize, "Error, profile not allowed for mode %s", operatingModeName(activeOperatingMode()));
+    return 1;
+}
+
 } // namespace raumata
 
 #endif // RAUMATA_DUAL_PROTOCOL
diff --git a/src/raumata/companion/CompanionHooks.h b/src/raumata/companion/CompanionHooks.h
index e8d51be75e0e8039e052bdb302262bec91f81a4c..352fd59b8af0230b3c3037fffeea72419f2dd8e0 100644
--- a/src/raumata/companion/CompanionHooks.h
+++ b/src/raumata/companion/CompanionHooks.h
@@ -21,4 +21,8 @@ void refreshCompanionLocation(double &lat, double &lon);
 
 bool handleCompanionExtension(const uint8_t *frame, size_t len, BaseSerialInterface *serial);
 
+/// Companion text CLI. 0 = not handled, 1 = handled, 2 = handled and the
+/// companion's radio prefs should be copied from the shared profile.
+int handleCompanionCli(const char *command, char *reply, size_t replySize);
+
 } // namespace raumata
diff --git a/src/raumata/companion/MyMesh.cpp b/src/raumata/companion/MyMesh.cpp
index 69997b2ff0718215481d08d34ad91e1a74a28e8b..62c4d27d440f04221e093aaa07b14ba40b1b4d46 100644
--- a/src/raumata/companion/MyMesh.cpp
+++ b/src/raumata/companion/MyMesh.cpp
@@ -1487,12 +1487,14 @@ void MyMesh::handleCmdFrame(size_t len) {
     i += 4;
     memcpy(&af, &cmd_frame[i], 4);
     i += 4;
+    (void)af;
     _prefs.rx_delay_base = ((float)rx) / 1000.0f;
-    _prefs.airtime_factor = ((float)af) / 1000.0f;
+    // The operating mode owns each stack's airtime share. Keep rx delay.
     savePrefs();
     writeOKFrame();
   } else if (cmd_frame[0] == CMD_GET_TUNING_PARAMS) {
-    uint32_t rx = _prefs.rx_delay_base * 1000, af = _prefs.airtime_factor * 1000;
+    uint32_t rx = _prefs.rx_delay_base * 1000;
+    uint32_t af = (uint32_t)(raumata::meshCoreBudgetFactor() * 1000.0f);
     int i = 0;
     out_frame[i++] = RESP_CODE_TUNING_PARAMS;
     memcpy(&out_frame[i], &rx, 4); i += 4;
@@ -2109,6 +2111,15 @@ bool MyMesh::handleCommand(const char* command, uint32_t sender_timestamp, char*
     command += 3;
   }
 
+  int raumataCli = raumata::handleCompanionCli(command, reply, 160);
+  if (raumataCli) {
+    if (raumataCli == 2) {
+      raumata::syncCompanionRadioPrefs(_prefs.freq, _prefs.bw, _prefs.sf, _prefs.cr, _prefs.tx_power_dbm);
+      savePrefs();
+    }
+    return true;
+  }
+
   if (_prefs.getRadioPrefs()->handleCommand(command, sender_timestamp, reply)) {  // is radio CLI command?
     if (_prefs.getRadioPrefs()->isDirty()) { savePrefs(); }
     return true;
diff --git a/src/raumata/companion/MyMesh.h b/src/raumata/companion/MyMesh.h
index 43bb28239e9a1e541c2bf498c8a6d78ddadee2b9..71af1dffecc80f8c48c288b8722cd5fe40291a8c 100644
--- a/src/raumata/companion/MyMesh.h
+++ b/src/raumata/companion/MyMesh.h
@@ -123,6 +123,13 @@ public:
   void handleCmdFrame(size_t len);
   bool advert();
   bool sendSelfAdvert(bool flood);
+  bool importLegacyContact(const ContactInfo &contact) { return addContact(contact); }
+  bool importLegacyChannel(uint8_t idx, const ChannelDetails &channel) { return setChannel(idx, channel); }
+  void saveImportedState()
+  {
+    saveContacts();
+    saveChannels();
+  }
   void enterCLIRescue();
 
   int  getRecentlyHeard(AdvertPath dest[], int max_num);
