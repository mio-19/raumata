diff --git a/src/raumata/OperatingMode.cpp b/src/raumata/OperatingMode.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..c6aec9a73a9e2fc1563de6657b60c3b70d45cf51
--- /dev/null
+++ b/src/raumata/OperatingMode.cpp
@@ -0,0 +1,312 @@
+#ifdef RAUMATA_DUAL_PROTOCOL
+#include "OperatingMode.h"
+
+#include <Arduino.h>
+#include <Preferences.h>
+#include <cstdio>
+#include <cstring>
+
+#include "PhyProfile.h"
+#include "mesh/NodeDB.h"
+#include "mesh/generated/meshtastic/mesh.pb.h"
+
+namespace raumata {
+namespace {
+
+struct SavedModeRecord {
+    uint8_t version;
+    uint8_t mode;
+    uint8_t last_meshtastic_id;
+    uint8_t last_meshcore_id;
+};
+
+constexpr uint8_t kSavedModeVersion = 1;
+constexpr float kMainlyPrimaryShare = 0.90f;
+constexpr float kMainlySecondaryShare = 0.10f;
+constexpr float kSharedShare = 0.50f;
+
+OperatingMode gMode = MODE_SHARED_MESHTASTIC_PHY;
+uint8_t gLastMeshtasticId = 0;
+uint8_t gLastMeshCoreId = 0;
+
+bool validMode(uint8_t mode)
+{
+    return mode <= MODE_SHARED_MESHCORE_PHY;
+}
+
+void saveModeToNvs()
+{
+    SavedModeRecord rec = {};
+    rec.version = kSavedModeVersion;
+    rec.mode = static_cast<uint8_t>(gMode);
+    rec.last_meshtastic_id = gLastMeshtasticId;
+    rec.last_meshcore_id = gLastMeshCoreId;
+
+    Preferences prefs;
+    if (prefs.begin("raumata", false)) {
+        prefs.putBytes("mode", &rec, sizeof(rec));
+        prefs.end();
+    }
+}
+
+bool loadModeFromNvs()
+{
+    Preferences prefs;
+    if (!prefs.begin("raumata", true)) {
+        return false;
+    }
+    size_t len = prefs.getBytesLength("mode");
+    if (len != sizeof(SavedModeRecord)) {
+        prefs.end();
+        return false;
+    }
+    SavedModeRecord rec = {};
+    bool ok = prefs.getBytes("mode", &rec, sizeof(rec)) == sizeof(rec);
+    prefs.end();
+    if (!ok || rec.version != kSavedModeVersion || !validMode(rec.mode)) {
+        return false;
+    }
+    gMode = static_cast<OperatingMode>(rec.mode);
+    gLastMeshtasticId = rec.last_meshtastic_id;
+    gLastMeshCoreId = rec.last_meshcore_id;
+    return true;
+}
+
+uint8_t regionDefaultProfile(bool meshcore)
+{
+    const auto region = config.lora.region;
+    if (!meshcore) {
+        if (region == meshtastic_Config_LoRaConfig_RegionCode_US) {
+            return 4;
+        }
+        if (region == meshtastic_Config_LoRaConfig_RegionCode_EU_868) {
+            return 5;
+        }
+        return 1;
+    }
+    if (region == meshtastic_Config_LoRaConfig_RegionCode_US) {
+        return 12;
+    }
+    if (region == meshtastic_Config_LoRaConfig_RegionCode_EU_868) {
+        return 13;
+    }
+    if (region == meshtastic_Config_LoRaConfig_RegionCode_NZ_865) {
+        return 11;
+    }
+    return 10;
+}
+
+} // namespace
+
+OperatingMode activeOperatingMode()
+{
+    return gMode;
+}
+
+const char *operatingModeName(OperatingMode mode)
+{
+    switch (mode) {
+    case MODE_MAINLY_MESHTASTIC:
+        return "mainly-meshtastic";
+    case MODE_MAINLY_MESHCORE:
+        return "mainly-meshcore";
+    case MODE_SHARED_MESHTASTIC_PHY:
+        return "shared-meshtastic";
+    case MODE_SHARED_MESHCORE_PHY:
+        return "shared-meshcore";
+    }
+    return "shared-meshtastic";
+}
+
+bool parseOperatingModeName(const char *name, OperatingMode &out)
+{
+    if (!name || !name[0]) {
+        return false;
+    }
+    if (strcmp(name, "mainly-meshtastic") == 0 || strcmp(name, "meshtastic") == 0) {
+        out = MODE_MAINLY_MESHTASTIC;
+        return true;
+    }
+    if (strcmp(name, "mainly-meshcore") == 0 || strcmp(name, "meshcore") == 0) {
+        out = MODE_MAINLY_MESHCORE;
+        return true;
+    }
+    if (strcmp(name, "shared-meshtastic") == 0 || strcmp(name, "both-meshtastic") == 0) {
+        out = MODE_SHARED_MESHTASTIC_PHY;
+        return true;
+    }
+    if (strcmp(name, "shared-meshcore") == 0 || strcmp(name, "both-meshcore") == 0) {
+        out = MODE_SHARED_MESHCORE_PHY;
+        return true;
+    }
+    return false;
+}
+
+bool operatingModeUsesMeshtasticPhy(OperatingMode mode)
+{
+    return mode == MODE_MAINLY_MESHTASTIC || mode == MODE_SHARED_MESHTASTIC_PHY;
+}
+
+bool operatingModeUsesMeshCorePhy(OperatingMode mode)
+{
+    return mode == MODE_MAINLY_MESHCORE || mode == MODE_SHARED_MESHCORE_PHY;
+}
+
+float meshCoreAirtimeShare()
+{
+    switch (gMode) {
+    case MODE_MAINLY_MESHTASTIC:
+        return kMainlySecondaryShare;
+    case MODE_MAINLY_MESHCORE:
+        return kMainlyPrimaryShare;
+    case MODE_SHARED_MESHTASTIC_PHY:
+    case MODE_SHARED_MESHCORE_PHY:
+        return kSharedShare;
+    }
+    return kSharedShare;
+}
+
+bool meshCorePresenceEnabled()
+{
+    return gMode != MODE_MAINLY_MESHTASTIC;
+}
+
+bool meshtasticPresenceEnabled()
+{
+    return gMode != MODE_MAINLY_MESHCORE;
+}
+
+bool meshtasticPacketMayTransmit(uint8_t priority)
+{
+    if (meshtasticPresenceEnabled()) {
+        return true;
+    }
+    return priority >= meshtastic_MeshPacket_Priority_DEFAULT;
+}
+
+bool profileKindAllowed(uint8_t kind)
+{
+    if (operatingModeUsesMeshtasticPhy(gMode)) {
+        return kind == PHY_MESHTASTIC_PRESET;
+    }
+    if (operatingModeUsesMeshCorePhy(gMode)) {
+        return kind == PHY_MESHCORE_PRESET;
+    }
+    return false;
+}
+
+void rememberProfileId(uint8_t id, uint8_t kind)
+{
+    if (id == 0 || id == kPhyProfileCustomId) {
+        return;
+    }
+    if (kind == PHY_MESHTASTIC_PRESET) {
+        gLastMeshtasticId = id;
+    } else if (kind == PHY_MESHCORE_PRESET) {
+        gLastMeshCoreId = id;
+    } else {
+        return;
+    }
+    saveModeToNvs();
+}
+
+uint8_t defaultProfileIdForMode(OperatingMode mode)
+{
+    const bool meshcore = operatingModeUsesMeshCorePhy(mode);
+    const uint8_t remembered = meshcore ? gLastMeshCoreId : gLastMeshtasticId;
+    const PhyProfile *preset = findPhyPreset(remembered);
+    const uint8_t want = meshcore ? static_cast<uint8_t>(PHY_MESHCORE_PRESET)
+                                  : static_cast<uint8_t>(PHY_MESHTASTIC_PRESET);
+    if (preset && static_cast<uint8_t>(preset->kind) == want) {
+        return preset->id;
+    }
+    return regionDefaultProfile(meshcore);
+}
+
+OperatingMode loadOrInferOperatingMode(uint8_t savedKind, uint8_t savedSync, bool haveSavedProfile)
+{
+    if (loadModeFromNvs()) {
+        return gMode;
+    }
+
+    gMode = MODE_SHARED_MESHTASTIC_PHY;
+    if (haveSavedProfile) {
+        const bool meshcoreFamily = savedKind == PHY_MESHCORE_PRESET ||
+                                    (savedKind == PHY_DUAL_PRESET && savedSync == kDefaultMeshCoreSyncWord) ||
+                                    (savedKind == PHY_CUSTOM && savedSync == kDefaultMeshCoreSyncWord);
+        if (meshcoreFamily) {
+            gMode = MODE_SHARED_MESHCORE_PHY;
+        }
+    }
+    saveModeToNvs();
+    return gMode;
+}
+
+bool applyOperatingMode(OperatingMode mode)
+{
+    if (!validMode(static_cast<uint8_t>(mode))) {
+        return false;
+    }
+
+    const bool changed = gMode != mode;
+    gMode = mode;
+    saveModeToNvs();
+
+    if (!profileKindAllowed(static_cast<uint8_t>(activePhyProfile().kind))) {
+        return applyPhyProfile(defaultProfileIdForMode(mode));
+    }
+    if (changed) {
+        notifyOperatingModeChanged();
+    }
+    return true;
+}
+
+bool handleModeCliCommand(const char *command, char *reply, size_t replySize)
+{
+    if (!command || !reply || replySize == 0) {
+        return false;
+    }
+    if (strncmp(command, "mode", 4) != 0 || (command[4] != '\0' && command[4] != ' ')) {
+        return false;
+    }
+
+    const char *args = command + 4;
+    while (*args == ' ') {
+        args++;
+    }
+
+    if (*args == '\0' || strcmp(args, "get") == 0) {
+        snprintf(reply, replySize, "mode %s phy=%u (%s) mc_share=%.0f%%", operatingModeName(gMode),
+                 activePhyProfile().id, activePhyProfile().name, meshCoreAirtimeShare() * 100.0f);
+        return true;
+    }
+
+    if (strcmp(args, "list") == 0) {
+        snprintf(reply, replySize,
+                 "mainly-meshtastic, mainly-meshcore, shared-meshtastic, shared-meshcore");
+        return true;
+    }
+
+    if (strncmp(args, "set ", 4) == 0) {
+        const char *name = args + 4;
+        while (*name == ' ') {
+            name++;
+        }
+        OperatingMode mode;
+        if (!parseOperatingModeName(name, mode) || !applyOperatingMode(mode)) {
+            snprintf(reply, replySize,
+                     "err: usage mode set <mainly-meshtastic|mainly-meshcore|shared-meshtastic|shared-meshcore>");
+            return true;
+        }
+        snprintf(reply, replySize, "ok: mode %s phy=%u (%s)", operatingModeName(gMode), activePhyProfile().id,
+                 activePhyProfile().name);
+        return true;
+    }
+
+    snprintf(reply, replySize, "err: usage mode [get|list|set <name>]");
+    return true;
+}
+
+} // namespace raumata
+
+#endif // RAUMATA_DUAL_PROTOCOL
diff --git a/src/raumata/OperatingMode.h b/src/raumata/OperatingMode.h
new file mode 100644
index 0000000000000000000000000000000000000000..84a7048e976175f8ace3125d0095e2b2e466b812
--- /dev/null
+++ b/src/raumata/OperatingMode.h
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace raumata {
+
+/**
+ * How this node shares one radio between Meshtastic and MeshCore.
+ *
+ * The radio stays on one physical configuration. The mode chooses which
+ * protocol family supplies that configuration, which stack may originate
+ * background traffic, and how the shared airtime budget is split.
+ */
+enum OperatingMode : uint8_t {
+    /// Meshtastic profile (sync 0x2B). Meshtastic presence and most airtime.
+    /// MeshCore stays up for the companion, but does not advertise.
+    MODE_MAINLY_MESHTASTIC = 0,
+    /// MeshCore profile (sync 0x12). MeshCore presence and most airtime.
+    /// Meshtastic background traffic (nodeinfo, position, telemetry) stays off.
+    MODE_MAINLY_MESHCORE = 1,
+    /// Both stacks advertise and send. Physical configuration is a Meshtastic preset.
+    MODE_SHARED_MESHTASTIC_PHY = 2,
+    /// Both stacks advertise and send. Physical configuration is a MeshCore preset.
+    MODE_SHARED_MESHCORE_PHY = 3,
+};
+
+OperatingMode activeOperatingMode();
+const char *operatingModeName(OperatingMode mode);
+bool parseOperatingModeName(const char *name, OperatingMode &out);
+
+bool operatingModeUsesMeshtasticPhy(OperatingMode mode);
+bool operatingModeUsesMeshCorePhy(OperatingMode mode);
