+    suspend fun refreshRadio() {
+        val conn = connection.value ?: return
+        radioMutex.withLock {
+            runCatching { radioStateFromCustomVars(conn.getCustomVars()) }
+                .onSuccess { _radio.value = it }
+                .onFailure { _error.value = it.message ?: "Could not read the radio mode" }
+        }
+    }
