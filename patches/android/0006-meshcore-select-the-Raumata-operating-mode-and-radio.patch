+        val conn = connection.value ?: return
+        radioMutex.withLock {
+            runCatching { conn.setCustomVar("mode", mode.wire) }
+                .onSuccess { _radio.value = radioStateFromCustomVars(conn.getCustomVars()) }
+                .onFailure { _error.value = it.message ?: "Could not set the operating mode" }
+        }
+    }
+
+    suspend fun setPhyProfile(id: Int) {
+        val conn = connection.value ?: return
+        radioMutex.withLock {
+            runCatching { conn.setCustomVar("phy.id", id.toString()) }
+                .onSuccess { _radio.value = radioStateFromCustomVars(conn.getCustomVars()) }
+                .onFailure { _error.value = it.message ?: "Could not set the radio profile" }
+        }
+    }
+
     fun clearError() {
         _error.value = null
     }
