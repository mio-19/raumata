+package org.meshtastic.feature.meshcore.model
+
+/** Which preset family supplies the single physical radio configuration. */
+enum class PhyFamily {
+    MESHTASTIC,
+    MESHCORE,
+}
+
+/**
+ * How one radio is shared. The wire values match the firmware `mode` custom var.
+ */
+enum class OperatingMode(
+    val wire: String,
+    val label: String,
+    val summary: String,
+    val family: PhyFamily,
+) {
+    MAINLY_MESHTASTIC(
+        wire = "mainly-meshtastic",
+        label = "Mainly Meshtastic",
+        summary = "Meshtastic profile and presence. MeshCore stays connected and does not advertise.",
+        family = PhyFamily.MESHTASTIC,
+    ),
+    MAINLY_MESHCORE(
+        wire = "mainly-meshcore",
+        label = "Mainly MeshCore",
+        summary = "MeshCore profile and presence. Meshtastic background traffic stays off.",
+        family = PhyFamily.MESHCORE,
+    ),
+    SHARED_MESHTASTIC(
+        wire = "shared-meshtastic",
+        label = "Both · Meshtastic PHY",
+        summary = "Both protocols on a Meshtastic physical configuration (sync 0x2B).",
+        family = PhyFamily.MESHTASTIC,
+    ),
+    SHARED_MESHCORE(
+        wire = "shared-meshcore",
+        label = "Both · MeshCore PHY",
+        summary = "Both protocols on a MeshCore physical configuration (sync 0x12).",
+        family = PhyFamily.MESHCORE,
+    ),
+    ;
+
+    companion object {
+        fun fromWire(value: String?): OperatingMode? = entries.firstOrNull { it.wire == value }
+    }
+}
+
+/** A native preset the firmware will accept for one family. Ids match the firmware table. */
+data class PhyPreset(
+    val id: Int,
+    val name: String,
+    val family: PhyFamily,
+    val detail: String,
+)
+
+val phyPresets: List<PhyPreset> =
+    listOf(
+        PhyPreset(1, "ANZ LongFast", PhyFamily.MESHTASTIC, "250 kHz · SF11 · 0x2B"),
+        PhyPreset(2, "ANZ MediumSlow", PhyFamily.MESHTASTIC, "250 kHz · SF10 · 0x2B"),
+        PhyPreset(3, "ANZ ShortFast", PhyFamily.MESHTASTIC, "250 kHz · SF7 · 0x2B"),
+        PhyPreset(4, "US LongFast", PhyFamily.MESHTASTIC, "250 kHz · SF11 · 0x2B"),
+        PhyPreset(5, "EU868 LongFast", PhyFamily.MESHTASTIC, "250 kHz · SF11 · 0x2B"),
+        PhyPreset(10, "Australia (Narrow)", PhyFamily.MESHCORE, "916.575 MHz · SF7 · 0x12"),
+        PhyPreset(11, "New Zealand (Narrow)", PhyFamily.MESHCORE, "917.375 MHz · SF7 · 0x12"),
+        PhyPreset(12, "US/Canada (Narrow)", PhyFamily.MESHCORE, "910.525 MHz · SF7 · 0x12"),
+        PhyPreset(13, "Portugal 868", PhyFamily.MESHCORE, "869.618 MHz · SF7 · 0x12"),
+    )
+
+/** Operating mode and preset reported by a Raumata node. */
+data class RaumataRadioState(
+    val mode: OperatingMode?,
+    val profileId: Int?,
+    val profileName: String,
+    val syncHex: String,
+)
+
+fun parseCustomVars(text: String): Map<String, String> {
+    val out = linkedMapOf<String, String>()
+    for (part in text.split(',')) {
+        val idx = part.indexOf(':')
+        if (idx <= 0) continue
+        out[part.substring(0, idx)] = part.substring(idx + 1)
+    }
+    return out
+}
+
+fun radioStateFromCustomVars(text: String): RaumataRadioState {
+    val vars = parseCustomVars(text)
+    return RaumataRadioState(
+        mode = OperatingMode.fromWire(vars["mode"]),
+        profileId = vars["phy.id"]?.toIntOrNull(),
+        profileName = vars["phy.name"].orEmpty(),
+        syncHex = vars["phy.sync"].orEmpty(),
+    )
+}
