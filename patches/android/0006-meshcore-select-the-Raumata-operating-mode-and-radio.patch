+@Composable
+private fun RadioModeCard(
+    radio: RaumataRadioState?,
+    onMode: (OperatingMode) -> Unit,
+    onProfile: (Int) -> Unit,
+) {
+    val mode = radio?.mode
+    Card(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 8.dp)) {
+        Column(modifier = Modifier.padding(12.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text("Radio mode", style = MaterialTheme.typography.titleMedium)
+            if (mode == null) {
+                Text("This node did not report a Raumata operating mode.")
+                return@Column
+            }
+            Text(mode.summary, style = MaterialTheme.typography.bodySmall)
+            Row(
+                modifier = Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                OperatingMode.entries.forEach { choice ->
+                    FilterChip(
+                        selected = choice == mode,
+                        onClick = { onMode(choice) },
+                        label = { Text(choice.label) },
+                    )
+                }
+            }
+            val activeName = radio.profileName.ifBlank { "Profile ${radio.profileId ?: "?"}" }
+            val sync = if (radio.syncHex.isBlank()) "" else " · sync 0x${radio.syncHex}"
+            Text("$activeName$sync", style = MaterialTheme.typography.bodyMedium)
+            Row(
+                modifier = Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                phyPresets.filter { it.family == mode.family }.forEach { preset ->
+                    FilterChip(
+                        selected = preset.id == radio.profileId,
+                        onClick = { onProfile(preset.id) },
+                        label = { Text(preset.name) },
+                    )
+                }
+            }
+        }
+    }
+}
