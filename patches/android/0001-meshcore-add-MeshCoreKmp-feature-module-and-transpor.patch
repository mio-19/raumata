+
+/**
+ * Android transports for MeshCoreKmp.
+ *
+ * BLE goes through MeshCoreKmp's BlueFalcon adapter. USB is exposed through a
+ * [com.darkrockstudios.libs.meshcore.ble.BleAdapter] shim so the same
+ * [com.darkrockstudios.libs.meshcore.DeviceScanner] and [DeviceConnection]
+ * machinery handles both transports.
+ */
+@Single
+class AndroidMeshCoreAdapters(
+    usbRepository: UsbRepository,
+) : MeshCoreAdapters {
+    override val ble = BlueFalconBleAdapter(BlueFalcon(context = ContextServices.app))
+
+    override val usb = UsbMeshCoreAdapter(usbRepository)
+}
