+package org.meshtastic.feature.meshcore.model
+
+/** Physical transport used to reach a MeshCore companion. */
+enum class MeshCoreTransport {
+    USB,
+    BLE,
+}
+
+/** A MeshCore companion discovered on a transport. */
+data class MeshCoreDevice(
+    val id: String,
+    val name: String,
+    val rssi: Int,
+    val transport: MeshCoreTransport,
+)
+
+/**
+ * A message shown in the dedicated MeshCore chat surface.
+ *
+ * MeshCore does not echo sent messages, so outgoing messages are recorded locally.
+ */
+data class MeshCoreChatMessage(
+    val text: String,
+    val outgoing: Boolean,
+    val channelIndex: Int? = null,
+    val contactPrefix: String? = null,
+    val timestamp: Long = 0,
+)
