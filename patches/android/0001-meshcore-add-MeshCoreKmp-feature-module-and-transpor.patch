+package org.meshtastic.feature.meshcore
+
+import com.darkrockstudios.libs.meshcore.ble.BleConnection
+import com.darkrockstudios.libs.meshcore.ble.ConnectionState
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.receiveAsFlow
+import kotlinx.coroutines.withTimeoutOrNull
+import org.meshtastic.core.network.repository.SerialConnection
+import org.meshtastic.core.network.repository.SerialConnectionListener
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * A [BleConnection] over MeshCore's USB CDC framing.
+ *
+ * MeshCore USB uses `>` + uint16 LE length + payload for frames from the
+ * firmware and `<` + uint16 LE length + payload for frames to the firmware.
+ * MeshCoreKmp's BLE connection deals in complete command payloads, so the
+ * framing is added/stripped here.
+ */
+class UsbMeshCoreConnection(
+    override val deviceIdentifier: String,
+    private val openSerial: (SerialConnectionListener) -> SerialConnection,
+) : BleConnection, SerialConnectionListener {
+    private val _connectionState = MutableStateFlow<ConnectionState>(ConnectionState.Disconnected)
+    override val connectionState: StateFlow<ConnectionState> = _connectionState.asStateFlow()
+
+    private val incoming = Channel<ByteArray>(Channel.UNLIMITED)
+    override val incomingData: Flow<ByteArray> = incoming.receiveAsFlow()
+
+    private val connected = CompletableDeferred<Unit>()
+    private var serial: SerialConnection? = null
+
+    private var parserState = 0
+    private var frameLength = 0
+    private var framePosition = 0
+    private val frame = ByteArray(MAX_FRAME_SIZE)
+
+    suspend fun connect() {
+        _connectionState.value = ConnectionState.Connecting
+        val connection = openSerial(this)
+        serial = connection
+        runCatching { connection.connect() }
+            .onFailure {
+                _connectionState.value = ConnectionState.Error(it.message ?: "USB open failed")
+                throw it
+            }
+
+        val ready = withTimeoutOrNull(15.seconds) { connected.await() } != null
+        if (!ready) {
+            _connectionState.value = ConnectionState.Error("Timed out waiting for MeshCore USB device")
+            error("Timed out waiting for MeshCore USB device")
+        }
+    }
+
+    override suspend fun write(data: ByteArray) {
+        val connection = serial ?: error("MeshCore USB connection is not open")
+        val framed = ByteArray(FRAME_HEADER_SIZE + data.size)
+        framed[0] = '<'.code.toByte()
+        framed[1] = (data.size and 0xFF).toByte()
+        framed[2] = ((data.size shr 8) and 0xFF).toByte()
+        data.copyInto(framed, FRAME_HEADER_SIZE)
+        connection.sendBytes(framed)
+    }
+
+    override suspend fun requestMtu(mtu: Int): Int = MAX_FRAME_SIZE
+
+    override suspend fun disconnect() {
+        runCatching { serial?.close(true) }
+        serial = null
+        _connectionState.value = ConnectionState.Disconnected
+    }
+
+    override fun onConnected() {
+        _connectionState.value = ConnectionState.Connected
+        if (!connected.isCompleted) connected.complete(Unit)
+    }
+
+    override fun onMissingPermission() {
+        _connectionState.value = ConnectionState.Error("USB permission denied")
+        if (!connected.isCompleted) {
+            connected.completeExceptionally(IllegalStateException("USB permission denied"))
+        }
+    }
+
+    override fun onDisconnected(thrown: Exception?) {
+        _connectionState.value = ConnectionState.Disconnected
+        if (!connected.isCompleted) {
+            connected.completeExceptionally(thrown ?: IllegalStateException("USB device disconnected"))
+        }
+    }
+
+    override fun onDataReceived(bytes: ByteArray) {
+        for (byte in bytes) {
+            val value = byte.toInt() and 0xFF
+            when (parserState) {
+                STATE_IDLE -> if (value == '>'.code) parserState = STATE_LENGTH_LOW
+                STATE_LENGTH_LOW -> {
+                    frameLength = value
+                    parserState = STATE_LENGTH_HIGH
+                }
+                STATE_LENGTH_HIGH -> {
+                    frameLength = frameLength or (value shl 8)
+                    if (frameLength in 1..frame.size) {
+                        framePosition = 0
+                        parserState = STATE_PAYLOAD
+                    } else {
+                        parserState = STATE_IDLE
+                    }
+                }
+                STATE_PAYLOAD -> {
+                    frame[framePosition++] = byte
+                    if (framePosition >= frameLength) {
+                        incoming.trySend(frame.copyOf(frameLength))
+                        parserState = STATE_IDLE
+                    }
+                }
+            }
+        }
+    }
+
+    private companion object {
+        const val FRAME_HEADER_SIZE = 3
+        const val MAX_FRAME_SIZE = 176
+        const val STATE_IDLE = 0
+        const val STATE_LENGTH_LOW = 1
+        const val STATE_LENGTH_HIGH = 2
+        const val STATE_PAYLOAD = 3
+    }
+}
