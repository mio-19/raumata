diff --git a/feature/meshcore/src/commonMain/kotlin/org/meshtastic/feature/meshcore/MeshCoreRepository.kt b/feature/meshcore/src/commonMain/kotlin/org/meshtastic/feature/meshcore/MeshCoreRepository.kt
new file mode 100644
index 0000000000000000000000000000000000000000..fe2dcb34aa2ef9a5e35fafbc6a3ab29bc9683902
