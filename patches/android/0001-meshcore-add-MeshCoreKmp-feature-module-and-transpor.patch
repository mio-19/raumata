+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+package org.meshtastic.feature.meshcore
+
+import com.darkrockstudios.libs.meshcore.ConnectionConfig
+import com.darkrockstudios.libs.meshcore.DeviceConnection
+import com.darkrockstudios.libs.meshcore.DeviceScanner
+import com.darkrockstudios.libs.meshcore.ble.ConnectionState
+import com.darkrockstudios.libs.meshcore.ble.DiscoveredDevice
+import com.darkrockstudios.libs.meshcore.model.Channel
+import com.darkrockstudios.libs.meshcore.model.Contact
+import com.darkrockstudios.libs.meshcore.model.ReceivedMessage
+import com.darkrockstudios.libs.meshcore.model.SelfInfo
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.filterNotNull
+import kotlinx.coroutines.flow.flatMapLatest
+import kotlinx.coroutines.flow.flowOf
+import kotlinx.coroutines.flow.stateIn
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import org.koin.core.annotation.Single
+import org.meshtastic.core.di.CoroutineDispatchers
+import org.meshtastic.feature.meshcore.model.MeshCoreChatMessage
+import org.meshtastic.feature.meshcore.model.MeshCoreDevice
+import org.meshtastic.feature.meshcore.model.MeshCoreTransport
+
+/**
+ * Owns the MeshCore companion connection independently of the Meshtastic radio.
+ *
+ * MeshCoreKmp supplies the protocol; this repository only adapts discovery,
+ * connection lifetime and the flat chat message history used by the dedicated tab.
+ */
+@OptIn(ExperimentalCoroutinesApi::class)
+@Single
+class MeshCoreRepository(
+    adapters: MeshCoreAdapters,
+    dispatchers: CoroutineDispatchers,
+) {
+    private val scope = CoroutineScope(SupervisorJob() + dispatchers.io)
+    private val bleScanner = DeviceScanner(adapters.ble)
+    private val usbScanner = DeviceScanner(adapters.usb)
+    private val connection = MutableStateFlow<DeviceConnection?>(null)
+
+    val devices: StateFlow<List<MeshCoreDevice>> =
+        combine(bleScanner.discoveredDevices, usbScanner.discoveredDevices) { ble, usb ->
+            ble.map {
+                MeshCoreDevice(
+                    id = it.identifier,
+                    name = it.name ?: it.identifier,
+                    rssi = it.rssi,
+                    transport = MeshCoreTransport.BLE,
+                )
+            } +
+                usb.map {
+                    MeshCoreDevice(
+                        id = it.identifier,
+                        name = it.name ?: it.identifier,
+                        rssi = it.rssi,
+                        transport = MeshCoreTransport.USB,
+                    )
+                }
+        }.stateIn(scope, SharingStarted.WhileSubscribed(5_000), emptyList<MeshCoreDevice>())
+
+    val connectionState: StateFlow<ConnectionState> =
+        connection
+            .flatMapLatest { it?.connectionState ?: flowOf(ConnectionState.Disconnected) }
+            .stateIn(scope, SharingStarted.WhileSubscribed(5_000), ConnectionState.Disconnected)
+
+    val channels: StateFlow<List<Channel>> =
+        connection
+            .flatMapLatest { it?.channels ?: flowOf(emptyList<Channel>()) }
+            .stateIn(scope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+    val contacts: StateFlow<List<Contact>> =
+        connection
+            .flatMapLatest { it?.contacts ?: flowOf(emptyList<Contact>()) }
+            .stateIn(scope, SharingStarted.WhileSubscribed(5_000), emptyList())
+
+    val selfInfo: StateFlow<SelfInfo?> =
+        connection
+            .flatMapLatest { it?.selfInfo ?: flowOf<SelfInfo?>(null) }
+            .stateIn(scope, SharingStarted.WhileSubscribed(5_000), null)
+
+    private val _messages = MutableStateFlow<List<MeshCoreChatMessage>>(emptyList())
+    val messages: StateFlow<List<MeshCoreChatMessage>> = _messages.asStateFlow()
+
+    private val _error = MutableStateFlow<String?>(null)
+    val error: StateFlow<String?> = _error.asStateFlow()
+
+    init {
+        scope.launch {
+            connection
+                .filterNotNull()
+                .flatMapLatest { it.incomingMessages }
+                .collect { message ->
+                    val chat =
+                        when (message) {
+                            is ReceivedMessage.ChannelMessage ->
+                                MeshCoreChatMessage(
+                                    text = message.text,
+                                    outgoing = false,
+                                    channelIndex = message.channelIndex,
+                                    timestamp = message.timestamp,
+                                )
+
+                            is ReceivedMessage.ContactMessage ->
+                                MeshCoreChatMessage(
+                                    text = message.text,
+                                    outgoing = false,
+                                    contactPrefix = message.publicKeyPrefix,
+                                    timestamp = message.timestamp,
+                                )
+                        }
+                    _messages.update { (it + chat).take(MAX_MESSAGES) }
+                }
+        }
+    }
+
+    fun startScan(transport: MeshCoreTransport?) {
+        if (transport == null || transport == MeshCoreTransport.BLE) {
+            bleScanner.startScan(scope = scope)
+        }
+        if (transport == null || transport == MeshCoreTransport.USB) {
+            usbScanner.startScan(scope = scope)
+        }
+    }
+
+    suspend fun connect(device: MeshCoreDevice) {
+        _error.value = null
+        bleScanner.stopScan()
+        usbScanner.stopScan()
+
+        val scanner = if (device.transport == MeshCoreTransport.BLE) bleScanner else usbScanner
+        val discovered = DiscoveredDevice(identifier = device.id, name = device.name, rssi = device.rssi)
+
+        runCatching {
+                scanner.connect(
+                    device = discovered,
+                    scope = scope,
+                    config =
+                        ConnectionConfig(
+                            appName = "Meshtastic",
+                            autoSyncTime = true,
+                            autoFetchChannels = true,
+                            autoFetchContacts = true,
+                            autoPollMessages = true,
+                        ),
+                )
+            }
+            .onSuccess {
+                connection.value = it
+                _messages.value = emptyList()
+            }
+            .onFailure { _error.value = it.message ?: "Could not connect to MeshCore device" }
+    }
+
+    suspend fun disconnect() {
+        connection.value?.disconnect()
+        connection.value = null
+    }
+
+    suspend fun sendChannelMessage(channelIndex: Int, text: String) {
+        val conn = connection.value ?: return
+        runCatching { conn.sendChannelMessage(channelIndex = channelIndex, text = text) }
+            .onSuccess {
+                _messages.update {
+                    (it +
+                            MeshCoreChatMessage(
+                                text = text,
+                                outgoing = true,
+                                channelIndex = channelIndex,
+                            ))
+                        .take(MAX_MESSAGES)
+                }
+            }
+            .onFailure { _error.value = it.message ?: "Could not send MeshCore message" }
+    }
+
+    suspend fun sendDirectMessage(contact: Contact, text: String) {
+        val conn = connection.value ?: return
+        runCatching { conn.sendDirectMessage(publicKeyPrefix = contact.publicKeyPrefix, text = text) }
+            .onSuccess {
+                _messages.update {
+                    (it +
+                            MeshCoreChatMessage(
+                                text = text,
+                                outgoing = true,
+                                contactPrefix = contact.publicKeyPrefixHex(),
+                            ))
+                        .take(MAX_MESSAGES)
+                }
+            }
+            .onFailure { _error.value = it.message ?: "Could not send MeshCore message" }
+    }
+
+    private companion object {
+        const val MAX_MESSAGES = 200
+    }
+}
