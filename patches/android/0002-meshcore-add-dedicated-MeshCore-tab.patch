+package org.meshtastic.feature.meshcore
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.darkrockstudios.libs.meshcore.model.Contact
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import org.koin.core.annotation.KoinViewModel
+import org.meshtastic.feature.meshcore.model.MeshCoreDevice
+import org.meshtastic.feature.meshcore.model.MeshCoreTransport
+
+@KoinViewModel
+class MeshCoreViewModel(private val repository: MeshCoreRepository) : ViewModel() {
+    val devices = repository.devices
+    val connectionState = repository.connectionState
+    val channels = repository.channels
+    val contacts = repository.contacts
+    val selfInfo = repository.selfInfo
+    val messages = repository.messages
+    val error = repository.error
+
+    private val _transport = MutableStateFlow(MeshCoreTransport.USB)
+    val transport: StateFlow<MeshCoreTransport> = _transport.asStateFlow()
+
+    private val _selectedChannel = MutableStateFlow<Int?>(null)
+    val selectedChannel: StateFlow<Int?> = _selectedChannel.asStateFlow()
+
+    private val _selectedContact = MutableStateFlow<Contact?>(null)
+    val selectedContact: StateFlow<Contact?> = _selectedContact.asStateFlow()
+
+    fun setTransport(transport: MeshCoreTransport) {
+        _transport.value = transport
+    }
+
+    fun scan() = repository.startScan(_transport.value)
+
+    fun scanAll() = repository.startScan(null)
+
+    fun connect(device: MeshCoreDevice) {
+        viewModelScope.launch { repository.connect(device) }
+    }
+
+    fun disconnect() {
+        viewModelScope.launch { repository.disconnect() }
+    }
+
+    fun selectChannel(index: Int) {
+        _selectedChannel.value = index
+        _selectedContact.value = null
+    }
+
+    fun selectContact(contact: Contact) {
+        _selectedContact.value = contact
+        _selectedChannel.value = null
+    }
+
+    fun clearSelection() {
+        _selectedChannel.value = null
+        _selectedContact.value = null
+    }
+
+    fun send(text: String) {
+        if (text.isBlank()) return
+        viewModelScope.launch {
+            val channel = _selectedChannel.value
+            val contact = _selectedContact.value
+            when {
+                channel != null -> repository.sendChannelMessage(channel, text)
+                contact != null -> repository.sendDirectMessage(contact, text)
+            }
+        }
+    }
+}
