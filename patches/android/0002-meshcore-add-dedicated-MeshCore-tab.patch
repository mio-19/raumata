+
+/**
+ * Dedicated MeshCore companion surface. It deliberately does not reuse the
+ * Meshtastic node/message data model: the two meshes have different identities,
+ * channels and contact databases.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun MeshCoreScreen(viewModel: MeshCoreViewModel = koinViewModel()) {
+    val connectionState by viewModel.connectionState.collectAsState()
+    val devices by viewModel.devices.collectAsState()
+    val channels by viewModel.channels.collectAsState()
+    val contacts by viewModel.contacts.collectAsState()
+    val messages by viewModel.messages.collectAsState()
+    val transport by viewModel.transport.collectAsState()
+    val selectedChannel by viewModel.selectedChannel.collectAsState()
+    val selectedContact by viewModel.selectedContact.collectAsState()
+    val error by viewModel.error.collectAsState()
+
+    val connected = connectionState is ConnectionState.Connected
+
+    Scaffold(
+        topBar = {
+            TopAppBar(
+                title = { Text("MeshCore") },
+                actions = {
+                    if (connected) {
+                        TextButton(onClick = viewModel::disconnect) { Text("Disconnect") }
+                    }
+                },
+            )
+        },
+    ) { padding ->
+        Column(modifier = Modifier.padding(padding).fillMaxSize()) {
+            ConnectionBanner(connectionState)
+            error?.let {
+                Text(
+                    text = it,
+                    color = MaterialTheme.colorScheme.error,
+                    modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp),
+                )
+            }
+
+            if (!connected) {
+                DevicePicker(
+                    transport = transport,
+                    devices = devices,
+                    onTransport = viewModel::setTransport,
+                    onScan = viewModel::scan,
+                    onConnect = viewModel::connect,
+                )
+            } else {
+                val channel = selectedChannel
+                val contact = selectedContact
+                if (channel == null && contact == null) {
+                    ConnectedBrowser(
+                        channels = channels,
+                        contacts = contacts,
+                        onChannel = viewModel::selectChannel,
+                        onContact = viewModel::selectContact,
+                    )
+                } else {
+                    val title =
+                        if (channel != null) {
+                            channels.firstOrNull { it.index == channel }?.name ?: "Channel $channel"
+                        } else {
+                            contact?.name ?: "Contact"
+                        }
+                    ChatPane(
+                        title = title,
+                        messages =
+                            messages.filter { message ->
+                                if (channel != null) {
+                                    message.channelIndex == channel && message.contactPrefix == null
+                                } else {
+                                    message.contactPrefix == contact?.publicKeyPrefixHex()
+                                }
+                            },
+                        onBack = viewModel::clearSelection,
+                        onSend = viewModel::send,
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun ConnectionBanner(state: ConnectionState) {
+    val text =
+        when (state) {
+            ConnectionState.Disconnected -> "Not connected"
+            ConnectionState.Connecting -> "Connecting…"
+            ConnectionState.Connected -> "Connected"
+            is ConnectionState.Error -> state.message
+        }
+    Text(
+        text = text,
+        style = MaterialTheme.typography.bodyMedium,
+        modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp),
+    )
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun DevicePicker(
+    transport: MeshCoreTransport,
+    devices: List<MeshCoreDevice>,
+    onTransport: (MeshCoreTransport) -> Unit,
+    onScan: () -> Unit,
+    onConnect: (MeshCoreDevice) -> Unit,
+) {
+    Column(modifier = Modifier.fillMaxSize().padding(16.dp)) {
+        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            FilterChip(
+                selected = transport == MeshCoreTransport.USB,
+                onClick = { onTransport(MeshCoreTransport.USB) },
+                label = { Text("USB") },
+            )
+            FilterChip(
+                selected = transport == MeshCoreTransport.BLE,
+                onClick = { onTransport(MeshCoreTransport.BLE) },
+                label = { Text("Bluetooth") },
+            )
+            Spacer(Modifier.weight(1f))
+            Button(onClick = onScan) { Text("Scan") }
+        }
+
+        Spacer(Modifier.height(12.dp))
+
+        if (devices.isEmpty()) {
+            Text("No MeshCore devices found. Tap Scan.")
+        } else {
+            LazyColumn(
+                modifier = Modifier.fillMaxSize(),
+                contentPadding = PaddingValues(vertical = 8.dp),
+                verticalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                items(items = devices, key = { it.id + ":" + it.transport.name }) { device ->
+                    Card(
+                        modifier = Modifier.fillMaxWidth(),
+                        onClick = { onConnect(device) },
+                    ) {
+                        Column(modifier = Modifier.padding(16.dp)) {
+                            Text(device.name, style = MaterialTheme.typography.titleMedium)
+                            Text("${device.transport.name} · ${device.rssi} dBm")
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun ConnectedBrowser(
+    channels: List<Channel>,
+    contacts: List<Contact>,
+    onChannel: (Int) -> Unit,
+    onContact: (Contact) -> Unit,
+) {
+    var tab by remember { mutableIntStateOf(0) }
+
+    Column(modifier = Modifier.fillMaxSize()) {
+        TabRow(selectedTabIndex = tab) {
+            Tab(selected = tab == 0, onClick = { tab = 0 }, text = { Text("Channels") })
+            Tab(selected = tab == 1, onClick = { tab = 1 }, text = { Text("Contacts") })
+        }
+
+        LazyColumn(
+            modifier = Modifier.fillMaxSize(),
+            contentPadding = PaddingValues(16.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            if (tab == 0) {
+                items(items = channels, key = { it.index }) { channel ->
+                    Card(modifier = Modifier.fillMaxWidth(), onClick = { onChannel(channel.index) }) {
+                        Column(modifier = Modifier.padding(16.dp)) {
+                            Text(channel.name, style = MaterialTheme.typography.titleMedium)
+                            Text("Channel ${channel.index}")
+                        }
+                    }
+                }
+            } else {
+                items(items = contacts, key = { it.publicKeyPrefixHex() }) { contact ->
+                    Card(modifier = Modifier.fillMaxWidth(), onClick = { onContact(contact) }) {
+                        Column(modifier = Modifier.padding(16.dp)) {
+                            Text(contact.name, style = MaterialTheme.typography.titleMedium)
+                            Text(contact.publicKeyPrefixHex())
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun ChatPane(
+    title: String,
+    messages: List<MeshCoreChatMessage>,
+    onBack: () -> Unit,
+    onSend: (String) -> Unit,
+) {
+    var draft by remember { mutableStateOf("") }
+
+    Column(modifier = Modifier.fillMaxSize().padding(16.dp)) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            TextButton(onClick = onBack) { Text("Back") }
+            Text(title, style = MaterialTheme.typography.titleMedium)
+        }
+
+        LazyColumn(
+            modifier = Modifier.weight(1f).fillMaxWidth(),
+            contentPadding = PaddingValues(vertical = 8.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            items(items = messages) { message ->
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    horizontalArrangement = if (message.outgoing) Arrangement.End else Arrangement.Start,
+                ) {
+                    Card {
+                        Text(message.text, modifier = Modifier.padding(10.dp))
+                    }
+                }
+            }
+        }
+
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            OutlinedTextField(
+                value = draft,
+                onValueChange = { draft = it },
+                modifier = Modifier.weight(1f),
+                placeholder = { Text("Message") },
+                maxLines = 3,
+            )
+            Button(
+                onClick = {
+                    onSend(draft)
+                    draft = ""
+                },
+                modifier = Modifier.padding(start = 8.dp),
+            ) {
+                Text("Send")
+            }
+        }
+    }
+}
