@@ -31,7 +31,14 @@ fun ByteArray.toPrefixHex(): String = joinToString(separator = "") { byte ->
 }
 
 /** Return the 6-byte public-key prefix of a MeshCore [Contact] as lowercase hex. */
-fun Contact.publicKeyPrefixHex(): String = publicKeyPrefix.toPrefixHex()
+fun Contact.publicKeyPrefixHex(): String = publicKeyPrefix
+
+/** Decode a 12-character MeshCore public-key prefix into the 6 bytes the library sends. */
+fun String.decodePrefixHex(): ByteArray {
+    val clean = trim()
+    require(clean.length == 12) { "MeshCore public key prefix must be 12 hex characters" }
+    return ByteArray(6) { index -> clean.substring(index * 2, index * 2 + 2).toInt(16).toByte() }
+}
 
