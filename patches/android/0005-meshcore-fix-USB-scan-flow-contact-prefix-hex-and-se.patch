diff --git a/feature/meshcore/src/androidMain/kotlin/org/meshtastic/feature/meshcore/UsbMeshCoreAdapter.kt b/feature/meshcore/src/androidMain/kotlin/org/meshtastic/feature/meshcore/UsbMeshCoreAdapter.kt
index dcd4133971109123291cd24b6dfc6b2bf558a2d8..a5a11468f588141a2da38ba352fae53f0ab09ef6 100644
--- a/feature/meshcore/src/androidMain/kotlin/org/meshtastic/feature/meshcore/UsbMeshCoreAdapter.kt
+++ b/feature/meshcore/src/androidMain/kotlin/org/meshtastic/feature/meshcore/UsbMeshCoreAdapter.kt
@@ -20,9 +20,10 @@ import com.darkrockstudios.libs.meshcore.ble.BleAdapter
 import com.darkrockstudios.libs.meshcore.ble.BleConnection
 import com.darkrockstudios.libs.meshcore.ble.DiscoveredDevice
 import com.darkrockstudios.libs.meshcore.ble.ScanFilter
+import kotlinx.coroutines.ExperimentalCoroutinesApi
 import kotlinx.coroutines.flow.Flow
 import kotlinx.coroutines.flow.firstOrNull
-import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.transformLatest
 import kotlinx.coroutines.withTimeoutOrNull
 import org.meshtastic.core.network.repository.UsbRepository
 import kotlin.time.Duration.Companion.seconds
@@ -34,15 +35,16 @@ import kotlin.time.Duration.Companion.seconds
  * BLE interface passes one command per characteristic write. [UsbMeshCoreConnection]
  * bridges that difference.
  */
+@OptIn(ExperimentalCoroutinesApi::class)
 class UsbMeshCoreAdapter(
     private val usbRepository: UsbRepository,
 ) : BleAdapter {
     override val isBluetoothEnabled: Boolean = usbRepository.isSupported
 
     override fun scan(filter: ScanFilter): Flow<DiscoveredDevice> =
-        usbRepository.serialDevices.map { drivers ->
-            drivers.map { (id, driver) ->
-                DiscoveredDevice(identifier = id, name = driver.device.deviceName, rssi = 0)
+        usbRepository.serialDevices.transformLatest { drivers ->
+            for ((id, driver) in drivers) {
+                emit(DiscoveredDevice(identifier = id, name = driver.device.deviceName, rssi = 0))
             }
         }
 
