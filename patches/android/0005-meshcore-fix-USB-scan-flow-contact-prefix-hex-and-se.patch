+import org.meshtastic.feature.meshcore.model.publicKeyPrefixHex
+import org.meshtastic.feature.meshcore.model.toPrefixHex
 
 /**
  * Owns the MeshCore companion connection independently of the Meshtastic radio.
@@ -132,7 +134,7 @@ class MeshCoreRepository(
                                 MeshCoreChatMessage(
                                     text = message.text,
                                     outgoing = false,
-                                    contactPrefix = message.publicKeyPrefix,
+                                    contactPrefix = message.publicKeyPrefix.toPrefixHex(),
                                     timestamp = message.timestamp,
                                 )
                         }
@@ -220,6 +222,25 @@ class MeshCoreRepository(
             .onFailure { _error.value = it.message ?: "Could not send MeshCore message" }
     }
 
+    suspend fun sendSelfAdvert(flood: Boolean = true) {
+        val conn = connection.value ?: return
+        runCatching { conn.sendSelfAdvert(flood = flood) }
+            .onFailure { _error.value = it.message ?: "Could not send MeshCore advert" }
+    }
+
+    suspend fun refresh() {
+        val conn = connection.value ?: return
+        runCatching {
+                conn.refreshChannels()
+                conn.refreshContacts()
+            }
+            .onFailure { _error.value = it.message ?: "Could not refresh MeshCore state" }
+    }
+
+    fun clearError() {
+        _error.value = null
+    }
+
     private companion object {
         const val MAX_MESSAGES = 200
     }
