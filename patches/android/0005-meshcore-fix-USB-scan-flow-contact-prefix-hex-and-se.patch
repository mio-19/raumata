 package org.meshtastic.feature.meshcore.model
 
+import com.darkrockstudios.libs.meshcore.model.Contact
+
 /** Physical transport used to reach a MeshCore companion. */
 enum class MeshCoreTransport {
     USB,
     BLE,
 }
 
+/** Format a raw public-key prefix byte array as lowercase hex. */
+fun ByteArray.toPrefixHex(): String = joinToString(separator = "") { byte ->
+    val v = byte.toInt() and 0xFF
+    v.toString(16).padStart(2, '0')
+}
+
+/** Return the 6-byte public-key prefix of a MeshCore [Contact] as lowercase hex. */
+fun Contact.publicKeyPrefixHex(): String = publicKeyPrefix.toPrefixHex()
+
 /** A MeshCore companion discovered on a transport. */
 data class MeshCoreDevice(
     val id: String,
