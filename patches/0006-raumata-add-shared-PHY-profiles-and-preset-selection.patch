+            if (cmdLen > sizeof(cmd) - 1) {
+                cmdLen = sizeof(cmd) - 1;
+            }
+            memcpy(cmd, &frame[1], cmdLen);
+            cmd[cmdLen] = 0;
+
+            uint8_t replyFrame[MAX_FRAME_SIZE];
+            replyFrame[0] = RESP_CODE_CLI_REPLY;
+            char *replyText = reinterpret_cast<char *>(&replyFrame[1]);
+            replyText[0] = 0;
+            if (handlePhyCliCommand(cmd, replyText, sizeof(replyFrame) - 1)) {
+                writer_(replyFrame, 1 + strlen(replyText));
+            } else {
+                writeError(ERR_CODE_UNSUPPORTED_CMD);
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
