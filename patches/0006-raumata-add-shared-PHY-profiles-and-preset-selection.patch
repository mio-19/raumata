+void MeshCoreNode::writePhyProfiles()
+{
+    size_t count = 0;
+    const PhyProfile *table = getPhyPresetTable(count);
+
+    uint8_t frame[MAX_FRAME_SIZE];
+    int i = 0;
+    frame[i++] = RESP_CODE_PHY_PROFILES;
+    frame[i++] = activePhyProfile().id;
+    frame[i++] = static_cast<uint8_t>(count);
+
+    for (size_t idx = 0; idx < count; idx++) {
+        // Compact per-preset entry: id(1) + kind(1) + sync(1) + sf(1) + cr(1) + preamble(2) + freq_khz(4) + bw_hz(4) = 15 bytes
+        if (i + 15 > static_cast<int>(sizeof(frame))) {
+            break;
+        }
+        const PhyProfile &p = table[idx];
+        frame[i++] = p.id;
+        frame[i++] = static_cast<uint8_t>(p.kind);
+        frame[i++] = p.sync_word;
+        frame[i++] = p.sf;
+        frame[i++] = p.cr;
+        memcpy(&frame[i], &p.preamble, 2);
+        i += 2;
+        uint32_t freqKhz = static_cast<uint32_t>(p.freq_mhz * 1000.0f);
+        uint32_t bwHz = static_cast<uint32_t>(p.bw_khz * 1000.0f);
+        memcpy(&frame[i], &freqKhz, 4);
+        i += 4;
+        memcpy(&frame[i], &bwHz, 4);
+        i += 4;
+    }
+
+    writer_(frame, i);
+}
+
+void MeshCoreNode::writeActivePhyProfile()
+{
+    const PhyProfile &p = activePhyProfile();
+    uint8_t frame[MAX_FRAME_SIZE];
+    int i = 0;
+
+    frame[i++] = RESP_CODE_PHY_PROFILE;
+    frame[i++] = p.id;
+    frame[i++] = static_cast<uint8_t>(p.kind);
+
+    uint32_t freqKhz = static_cast<uint32_t>(meshtasticRadio_.getFreq() * 1000.0f);
+    uint32_t bwHz = static_cast<uint32_t>(meshtasticRadio_.getBandwidthKHz() * 1000.0f);
+    memcpy(&frame[i], &freqKhz, 4);
+    i += 4;
+    memcpy(&frame[i], &bwHz, 4);
+    i += 4;
+    frame[i++] = meshtasticRadio_.getSpreadFactorValue();
+    frame[i++] = meshtasticRadio_.getCodingRateValue();
+    frame[i++] = activeSyncWord();
+    uint16_t preamble = activePreambleLength();
+    memcpy(&frame[i], &preamble, 2);
+    i += 2;
+    frame[i++] = static_cast<uint8_t>(meshtasticRadio_.getTxPower());
+
+    size_t nameLen = strlen(p.name);
+    if (i + static_cast<int>(nameLen) > static_cast<int>(sizeof(frame))) {
+        nameLen = sizeof(frame) - i;
+    }
+    memcpy(&frame[i], p.name, nameLen);
+    i += static_cast<int>(nameLen);
+
+    writer_(frame, i);
+}
