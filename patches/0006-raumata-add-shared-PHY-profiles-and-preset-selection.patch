+++ b/src/raumata/PhyProfile.h
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+
+#include "mesh/RadioInterface.h"
+
+namespace raumata {
+
+enum PhyProfileKind : uint8_t {
+    PHY_MESHTASTIC_PRESET = 0,
+    PHY_MESHCORE_PRESET = 1,
+    PHY_DUAL_PRESET = 2,
+    PHY_CUSTOM = 3,
+};
+
+constexpr uint8_t kPhyProfileCustomId = 255;
+constexpr uint8_t kDefaultMeshtasticSyncWord = 0x2B;
+constexpr uint8_t kDefaultMeshCoreSyncWord = 0x12;
+constexpr uint16_t kDefaultMeshtasticPreamble = 16;
+constexpr uint16_t kDefaultMeshCorePreamble = 32;
+
+struct PhyProfile {
+    uint8_t id;
+    const char *name;
+    PhyProfileKind kind;
+
+    // Meshtastic-preset fields
+    uint8_t msh_modem_preset;
+    uint16_t msh_channel_num;
+    uint8_t msh_region;
+
+    // Explicit PHY fields (MeshCore, dual, custom)
+    float freq_mhz;
+    float bw_khz;
+    uint8_t sf;
+    uint8_t cr;
+    uint8_t sync_word;
+    uint16_t preamble;
+    bool crc;
+    int8_t tx_power;
+};
+
+/// Return the static table of built-in PHY presets.
+const PhyProfile *getPhyPresetTable(size_t &count);
+
+/// Look up a built-in PHY preset by ID.
+const PhyProfile *findPhyPreset(uint8_t id);
+
+/// Return the currently active PHY profile.
+const PhyProfile &activePhyProfile();
+
+/// Effective sync word and preamble length for the active profile.
+uint8_t activeSyncWord();
+uint16_t activePreambleLength();
+
+/// True while applyPhyProfile/applyCustomPhyProfile is mutating config.lora.
+bool isApplyingPhyProfile();
+
+/// Load the saved PHY profile from NVS and apply it to config.lora before initLoRa().
+void phyInit();
+
+/// Bind the initialized RadioInterface and an optional callback invoked after runtime profile changes.
+void bindPhyRadio(RadioInterface *radio, std::function<void()> onProfileChanged = nullptr);
+
+/// Select and apply a built-in preset by ID at runtime.
+bool applyPhyProfile(uint8_t id);
+
+/// Apply a custom PHY configuration at runtime.
+bool applyCustomPhyProfile(float freq_mhz, float bw_khz, uint8_t sf, uint8_t cr, uint8_t sync_word,
+                           uint16_t preamble, int8_t tx_power);
+
+/// Update TX power on the active PHY profile and reconfigure the radio.
+bool applyTxPower(int8_t tx_power);
+
+/// Synchronize the active PHY profile when the Meshtastic app modifies config.lora.
+void onMeshtasticConfigChanged();
+
+/// Execute a "phy ..." CLI command and write a human-readable response into reply.
+bool handlePhyCliCommand(const char *command, char *reply, size_t replySize);
+
+} // namespace raumata
