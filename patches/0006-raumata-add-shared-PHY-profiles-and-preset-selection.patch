+
+bool isValidExplicitPhy(float freq_mhz, float bw_khz, uint8_t sf, uint8_t cr, uint16_t preamble)
+{
+    if (freq_mhz < 150.0f || freq_mhz > 960.0f) {
+        return false;
+    }
+    if (bw_khz < 7.8f || bw_khz > 500.0f) {
+        return false;
+    }
+    if (sf < LORA_SF_MIN || sf > LORA_SF_MAX) {
+        return false;
+    }
+    if (cr < LORA_CR_MIN || cr > LORA_CR_MAX) {
+        return false;
+    }
+    if (preamble < 4 || preamble > 256) {
+        return false;
+    }
+    return true;
+}
+
+void saveActiveProfileToNvs()
+{
+    SavedPhyRecord rec = {};
+    rec.version = kSavedPhyVersion;
+    rec.id = gActiveProfile.id;
+    rec.kind = static_cast<uint8_t>(gActiveProfile.kind);
+    rec.msh_modem_preset = gActiveProfile.msh_modem_preset;
+    rec.msh_channel_num = gActiveProfile.msh_channel_num;
+    rec.msh_region = gActiveProfile.msh_region;
+    rec.freq_mhz = gActiveProfile.freq_mhz;
+    rec.bw_khz = gActiveProfile.bw_khz;
+    rec.sf = gActiveProfile.sf;
+    rec.cr = gActiveProfile.cr;
+    rec.sync_word = gActiveProfile.sync_word;
+    rec.preamble = gActiveProfile.preamble;
+    rec.crc = gActiveProfile.crc ? 1 : 0;
+    rec.tx_power = gActiveProfile.tx_power;
+
+    Preferences prefs;
+    if (prefs.begin("raumata", false)) {
+        prefs.putBytes("phy", &rec, sizeof(rec));
+        prefs.end();
+    }
+}
+
+bool loadProfileFromNvs(PhyProfile &out)
+{
+    Preferences prefs;
+    if (!prefs.begin("raumata", true)) {
+        return false;
+    }
+
+    size_t len = prefs.getBytesLength("phy");
+    if (len != sizeof(SavedPhyRecord)) {
+        prefs.end();
+        return false;
+    }
+
+    SavedPhyRecord rec = {};
+    bool ok = prefs.getBytes("phy", &rec, sizeof(rec)) == sizeof(rec);
+    prefs.end();
+    if (!ok || rec.version != kSavedPhyVersion) {
+        return false;
+    }
+
+    const PhyProfile *preset = findPhyPreset(rec.id);
+    if (preset && rec.id != kPhyProfileCustomId) {
+        out = *preset;
+        if (rec.tx_power != 0) {
+            out.tx_power = rec.tx_power;
+        }
+        return true;
+    }
+
+    out.id = kPhyProfileCustomId;
+    out.name = "Custom";
+    out.kind = static_cast<PhyProfileKind>(rec.kind);
+    out.msh_modem_preset = rec.msh_modem_preset;
+    out.msh_channel_num = rec.msh_channel_num;
+    out.msh_region = rec.msh_region;
+    out.freq_mhz = rec.freq_mhz;
+    out.bw_khz = rec.bw_khz;
+    out.sf = rec.sf;
+    out.cr = rec.cr;
+    out.sync_word = rec.sync_word ? rec.sync_word : kDefaultMeshtasticSyncWord;
+    out.preamble = rec.preamble ? rec.preamble : kDefaultMeshtasticPreamble;
+    out.crc = rec.crc != 0;
+    out.tx_power = rec.tx_power ? rec.tx_power : 22;
+    return true;
+}
+
+PhyProfile deriveProfileFromMeshtasticConfig(uint8_t fallbackSync, uint16_t fallbackPreamble)
+{
+    if (config.lora.use_preset && config.lora.override_frequency == 0.0f) {
+        for (const auto &preset : kPresets) {
+            if (preset.kind == PHY_MESHTASTIC_PRESET &&
+                preset.msh_modem_preset == static_cast<uint8_t>(config.lora.modem_preset) &&
+                (preset.msh_region == static_cast<uint8_t>(config.lora.region) ||
+                 config.lora.region == meshtastic_Config_LoRaConfig_RegionCode_UNSET)) {
+                PhyProfile matched = preset;
+                matched.msh_channel_num = static_cast<uint16_t>(config.lora.channel_num);
+                if (config.lora.tx_power != 0) {
+                    matched.tx_power = config.lora.tx_power;
+                }
+                return matched;
+            }
+        }
+
+        float bw = LORA_BW_DEFAULT_KHZ;
+        uint8_t sf = LORA_SF_DEFAULT;
+        uint8_t cr = LORA_CR_DEFAULT;
+        modemPresetToParams(config.lora.modem_preset, false, bw, sf, cr);
+
+        PhyProfile msh = {};
+        msh.id = 1;
+        msh.name = "Meshtastic Preset";
+        msh.kind = PHY_MESHTASTIC_PRESET;
+        msh.msh_modem_preset = static_cast<uint8_t>(config.lora.modem_preset);
+        msh.msh_channel_num = static_cast<uint16_t>(config.lora.channel_num);
+        msh.msh_region = static_cast<uint8_t>(config.lora.region);
+        msh.freq_mhz = 0.0f;
+        msh.bw_khz = bw;
+        msh.sf = sf;
+        msh.cr = cr;
+        msh.sync_word = kDefaultMeshtasticSyncWord;
+        msh.preamble = kDefaultMeshtasticPreamble;
+        msh.crc = true;
+        msh.tx_power = config.lora.tx_power ? config.lora.tx_power : 22;
+        return msh;
+    }
+
+    PhyProfile custom = {};
+    custom.id = kPhyProfileCustomId;
+    custom.name = "Custom";
+    custom.kind = PHY_CUSTOM;
+    custom.msh_modem_preset = static_cast<uint8_t>(config.lora.modem_preset);
+    custom.msh_channel_num = static_cast<uint16_t>(config.lora.channel_num);
+    custom.msh_region = static_cast<uint8_t>(config.lora.region);
+    custom.freq_mhz = config.lora.override_frequency;
+    custom.bw_khz = clampBandwidthKHz(bwCodeToKHz(config.lora.bandwidth));
+    custom.sf = clampSpreadFactor(config.lora.spread_factor);
+    custom.cr = clampCodingRate(config.lora.coding_rate);
+    custom.sync_word = fallbackSync;
+    custom.preamble = fallbackPreamble;
+    custom.crc = true;
+    custom.tx_power = config.lora.tx_power ? config.lora.tx_power : 22;
+    return custom;
+}
+
+void writeProfileIntoLoRaConfig(const PhyProfile &profile)
+{
+    if (profile.kind == PHY_MESHTASTIC_PRESET) {
+        config.lora.use_preset = true;
+        config.lora.modem_preset = static_cast<meshtastic_Config_LoRaConfig_ModemPreset>(profile.msh_modem_preset);
+        config.lora.channel_num = profile.msh_channel_num;
+        config.lora.override_frequency = 0.0f;
+        if (config.lora.region == meshtastic_Config_LoRaConfig_RegionCode_UNSET && profile.msh_region != 0) {
+            config.lora.region = static_cast<meshtastic_Config_LoRaConfig_RegionCode>(profile.msh_region);
+            initRegion();
+        }
+        RadioInterface::bootstrapLoRaConfigFromPreset(config.lora);
+    } else {
+        config.lora.use_preset = false;
+        config.lora.bandwidth = bwKHzToCode(profile.bw_khz);
+        config.lora.spread_factor = profile.sf;
+        config.lora.coding_rate = profile.cr;
+        config.lora.override_frequency = profile.freq_mhz;
+        config.lora.channel_num = 0;
+        if (config.lora.region == meshtastic_Config_LoRaConfig_RegionCode_UNSET && profile.msh_region != 0) {
+            config.lora.region = static_cast<meshtastic_Config_LoRaConfig_RegionCode>(profile.msh_region);
+            initRegion();
+        }
+    }
+
+    if (profile.tx_power != 0) {
+        config.lora.tx_power = profile.tx_power;
+    }
+}
+
+bool commitActiveProfileToHardware()
+{
+    gApplyingProfile = true;
+    writeProfileIntoLoRaConfig(gActiveProfile);
+
+    if (gRadio) {
+        gRadio->setSyncWord(gActiveProfile.sync_word);
+        gRadio->setPreambleLength(gActiveProfile.preamble);
+        gRadio->reconfigure();
+    }
+
+    if (nodeDB) {
+        nodeDB->saveToDisk(SEGMENT_CONFIG);
+    }
+    saveActiveProfileToNvs();
+    gApplyingProfile = false;
+
+    if (gOnChanged) {
+        gOnChanged();
+    }
+    return true;
+}
+
+const char *kindName(PhyProfileKind kind)
+{
+    switch (kind) {
+    case PHY_MESHTASTIC_PRESET:
+        return "meshtastic";
+    case PHY_MESHCORE_PRESET:
+        return "meshcore";
+    case PHY_DUAL_PRESET:
+        return "dual";
+    case PHY_CUSTOM:
+    default:
+        return "custom";
+    }
+}
+
+} // namespace
+
+const PhyProfile *getPhyPresetTable(size_t &count)
+{
+    count = sizeof(kPresets) / sizeof(kPresets[0]);
+    return kPresets;
+}
+
+const PhyProfile *findPhyPreset(uint8_t id)
+{
+    for (const auto &preset : kPresets) {
+        if (preset.id == id) {
+            return &preset;
+        }
+    }
+    return nullptr;
+}
+
+const PhyProfile &activePhyProfile()
+{
+    return gActiveProfile;
+}
+
+uint8_t activeSyncWord()
+{
+    return gActiveProfile.sync_word ? gActiveProfile.sync_word : kDefaultMeshtasticSyncWord;
+}
+
+uint16_t activePreambleLength()
+{
+    return gActiveProfile.preamble ? gActiveProfile.preamble : kDefaultMeshtasticPreamble;
+}
+
+bool isApplyingPhyProfile()
+{
+    return gApplyingProfile;
+}
+
+void phyInit()
+{
+    PhyProfile loaded = {};
+    if (loadProfileFromNvs(loaded)) {
+        gActiveProfile = loaded;
+        gApplyingProfile = true;
+        writeProfileIntoLoRaConfig(gActiveProfile);
+        gApplyingProfile = false;
+    } else {
+        gActiveProfile = deriveProfileFromMeshtasticConfig(kDefaultMeshtasticSyncWord, kDefaultMeshtasticPreamble);
+        saveActiveProfileToNvs();
+    }
+}
+
+void bindPhyRadio(RadioInterface *radio, std::function<void()> onProfileChanged)
+{
+    gRadio = radio;
+    gOnChanged = std::move(onProfileChanged);
+    if (gRadio) {
+        gRadio->setSyncWord(activeSyncWord());
+        gRadio->setPreambleLength(activePreambleLength());
+    }
+}
+
+bool applyPhyProfile(uint8_t id)
+{
+    const PhyProfile *preset = findPhyPreset(id);
+    if (!preset) {
+        return false;
+    }
+
+    gActiveProfile = *preset;
+    return commitActiveProfileToHardware();
+}
+
+bool applyCustomPhyProfile(float freq_mhz, float bw_khz, uint8_t sf, uint8_t cr, uint8_t sync_word,
+                           uint16_t preamble, int8_t tx_power)
+{
+    if (!isValidExplicitPhy(freq_mhz, bw_khz, sf, cr, preamble) || sync_word == 0) {
+        return false;
+    }
+
+    gActiveProfile.id = kPhyProfileCustomId;
+    gActiveProfile.name = "Custom";
+    gActiveProfile.kind = PHY_CUSTOM;
+    gActiveProfile.msh_modem_preset = static_cast<uint8_t>(config.lora.modem_preset);
+    gActiveProfile.msh_channel_num = 0;
+    gActiveProfile.msh_region = static_cast<uint8_t>(config.lora.region);
+    gActiveProfile.freq_mhz = freq_mhz;
+    gActiveProfile.bw_khz = bw_khz;
+    gActiveProfile.sf = sf;
+    gActiveProfile.cr = cr;
+    gActiveProfile.sync_word = sync_word;
+    gActiveProfile.preamble = preamble;
+    gActiveProfile.crc = true;
+    gActiveProfile.tx_power = tx_power != 0 ? tx_power : gActiveProfile.tx_power;
+
+    return commitActiveProfileToHardware();
+}
+
+bool applyTxPower(int8_t tx_power)
+{
+    if (tx_power < -9 || tx_power > 30) {
+        return false;
+    }
+    gActiveProfile.tx_power = tx_power;
+    return commitActiveProfileToHardware();
+}
+
+void onMeshtasticConfigChanged()
+{
+    if (gApplyingProfile) {
+        return;
+    }
+
+    gActiveProfile = deriveProfileFromMeshtasticConfig(activeSyncWord(), activePreambleLength());
+    if (gRadio) {
+        gRadio->setSyncWord(activeSyncWord());
+        gRadio->setPreambleLength(activePreambleLength());
+    }
+    saveActiveProfileToNvs();
+    if (gOnChanged) {
+        gOnChanged();
+    }
+}
+
+bool handlePhyCliCommand(const char *command, char *reply, size_t replySize)
+{
+    if (!command || !reply || replySize == 0) {
+        return false;
+    }
+    if (strncmp(command, "phy", 3) != 0 || (command[3] != '\0' && command[3] != ' ')) {
+        return false;
+    }
+
+    const char *args = command + 3;
+    while (*args == ' ') {
+        args++;
+    }
+
+    if (*args == '\0' || strcmp(args, "get") == 0) {
+        float effFreq = gRadio ? gRadio->getFreq() : gActiveProfile.freq_mhz;
+        float effBw = gRadio ? gRadio->getBandwidthKHz() : gActiveProfile.bw_khz;
+        uint8_t effSf = gRadio ? gRadio->getSpreadFactorValue() : gActiveProfile.sf;
+        uint8_t effCr = gRadio ? gRadio->getCodingRateValue() : gActiveProfile.cr;
+        snprintf(reply, replySize, "phy id=%u (%s, %s) %.3fMHz BW%.1f SF%u CR%u sync=0x%02X pre=%u pwr=%ddBm",
+                 gActiveProfile.id, gActiveProfile.name, kindName(gActiveProfile.kind), effFreq, effBw, effSf, effCr,
+                 activeSyncWord(), activePreambleLength(), gRadio ? gRadio->getTxPower() : gActiveProfile.tx_power);
+        return true;
+    }
+
+    if (strcmp(args, "list") == 0) {
+        size_t count = 0;
+        const PhyProfile *table = getPhyPresetTable(count);
+        size_t pos = 0;
+        for (size_t i = 0; i < count && pos < replySize - 1; i++) {
+            int written = snprintf(reply + pos, replySize - pos, "%s%u:%s(0x%02X)", i == 0 ? "" : ", ", table[i].id,
+                                   table[i].name, table[i].sync_word);
+            if (written < 0) {
+                break;
+            }
+            pos += static_cast<size_t>(written);
+        }
+        return true;
+    }
+
+    if (strncmp(args, "set ", 4) == 0) {
+        const char *sub = args + 4;
+        while (*sub == ' ') {
+            sub++;
+        }
+        if (strncmp(sub, "custom ", 7) == 0) {
+            float freq = 0.0f;
+            float bw = 0.0f;
+            unsigned int sf = 0;
+            unsigned int cr = 0;
+            unsigned int sync = activeSyncWord();
+            unsigned int preamble = activePreambleLength();
+            int parsed = sscanf(sub + 7, "%f %f %u %u %x %u", &freq, &bw, &sf, &cr, &sync, &preamble);
+            if (parsed >= 4 &&
+                applyCustomPhyProfile(freq, bw, static_cast<uint8_t>(sf), static_cast<uint8_t>(cr),
+                                      static_cast<uint8_t>(sync), static_cast<uint16_t>(preamble),
+                                      gActiveProfile.tx_power)) {
+                snprintf(reply, replySize, "ok: custom %.3fMHz BW%.1f SF%u CR%u sync=0x%02X pre=%u", freq, bw, sf, cr,
+                         sync, preamble);
+            } else {
+                snprintf(reply, replySize, "err: usage phy set custom <freq_mhz> <bw_khz> <sf> <cr> [sync_hex] [pre]");
+            }
+            return true;
+        }
+
+        unsigned int id = static_cast<unsigned int>(strtoul(sub, nullptr, 10));
+        if (applyPhyProfile(static_cast<uint8_t>(id))) {
+            snprintf(reply, replySize, "ok: phy %u (%s) sync=0x%02X pre=%u", gActiveProfile.id, gActiveProfile.name,
+                     activeSyncWord(), activePreambleLength());
+        } else {
+            snprintf(reply, replySize, "err: unknown phy preset %u", id);
+        }
+        return true;
+    }
+
+    snprintf(reply, replySize, "err: usage phy [get|list|set <id>|set custom ...]");
+    return true;
+}
+
+} // namespace raumata
+
+#endif // RAUMATA_DUAL_PROTOCOL
