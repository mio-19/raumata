new file mode 100644
index 0000000000000000000000000000000000000000..b8f6df6b07a2a2b7417c0651bada517ab78ed947
--- /dev/null
+++ b/src/raumata/IdentityLink.cpp
@@ -0,0 +1,178 @@
+#ifdef RAUMATA_DUAL_PROTOCOL
+#include "IdentityLink.h"
+
+#include <Arduino.h>
+#include <Preferences.h>
+#include <SHA256.h>
+#include <cstdio>
+#include <cstring>
+
+#include <Utils.h>
+
+#include "PhyProfile.h"
+#include "gps/RTC.h"
+#include "mesh/MeshService.h"
+#include "mesh/NodeDB.h"
+
+namespace raumata {
+namespace {
+
+RaumataLinkRecord gLinkRecord = {};
+
+void hmacSha256(const uint8_t *key, size_t keyLen, const uint8_t *data, size_t dataLen, uint8_t out[32])
+{
+    SHA256 sha;
+    sha.resetHMAC(key, keyLen);
+    sha.update(data, dataLen);
+    sha.finalizeHMAC(key, keyLen, out, 32);
+}
+
+} // namespace
+
+void computeMeshtasticPubKeyFingerprint(uint8_t fp[8])
+{
+    memset(fp, 0, 8);
+    if (config.security.public_key.size > 0) {
+        mesh::Utils::sha256(fp, 8, config.security.public_key.bytes, config.security.public_key.size);
+    } else if (owner.public_key.size > 0) {
+        mesh::Utils::sha256(fp, 8, owner.public_key.bytes, owner.public_key.size);
+    } else {
+        uint32_t nodeNum = nodeDB ? nodeDB->getNodeNum() : 0;
+        mesh::Utils::sha256(fp, 8, reinterpret_cast<const uint8_t *>(&nodeNum), sizeof(nodeNum));
+    }
+}
+
+bool deriveMeshCoreSeed(uint8_t seed[32])
+{
+    if (config.security.private_key.size < 32 ||
+        mesh::Utils::isZeroes(config.security.private_key.bytes, 32)) {
+        return false;
+    }
+
+    // HKDF-SHA256(ikm = Meshtastic private key, salt = "raumata", info = "meshcore-identity-v1", len = 32)
+    static constexpr const char kSalt[] = "raumata";
+    static constexpr const char kInfo[] = "meshcore-identity-v1";
+
+    uint8_t prk[32];
+    hmacSha256(reinterpret_cast<const uint8_t *>(kSalt), sizeof(kSalt) - 1,
+               config.security.private_key.bytes, 32, prk);
+
+    uint8_t infoBlock[sizeof(kInfo)];
+    memcpy(infoBlock, kInfo, sizeof(kInfo) - 1);
+    infoBlock[sizeof(kInfo) - 1] = 0x01;
+    hmacSha256(prk, sizeof(prk), infoBlock, sizeof(infoBlock), seed);
+    memset(prk, 0, sizeof(prk));
+    return true;
+}
+
+bool loadLinkRecord(RaumataLinkRecord &out)
+{
+    Preferences prefs;
+    if (!prefs.begin("raumata", true)) {
+        return false;
+    }
+
+    size_t len = prefs.getBytesLength("link");
+    if (len != sizeof(RaumataLinkRecord)) {
+        prefs.end();
+        return false;
+    }
+
+    bool ok = prefs.getBytes("link", &out, sizeof(out)) == sizeof(out);
+    prefs.end();
+    return ok && out.version == kLinkRecordVersion;
+}
+
+const RaumataLinkRecord &activeLinkRecord()
+{
+    return gLinkRecord;
+}
+
+bool syncIdentityLink(const uint8_t mcPubKey[32], uint32_t nowSec, bool emitNotification)
+{
+    if (!mcPubKey) {
+        return false;
+    }
+
+    RaumataLinkRecord existing = {};
+    bool hadSaved = loadLinkRecord(existing);
+
+    uint8_t fp[8];
+    computeMeshtasticPubKeyFingerprint(fp);
+    uint32_t nodeNum = nodeDB ? nodeDB->getNodeNum() : 0;
+
+#if defined(RAUMATA_IDENTITY_DERIVED) && RAUMATA_IDENTITY_DERIVED
+    uint8_t mode = RAUMATA_ID_DERIVED;
+#else
+    uint8_t mode = RAUMATA_ID_INDEPENDENT;
+#endif
+
+    bool changed = !hadSaved || existing.version != kLinkRecordVersion || existing.mode != mode ||
+                   existing.msh_node_num != nodeNum ||
+                   memcmp(existing.mc_pubkey, mcPubKey, sizeof(existing.mc_pubkey)) != 0 ||
+                   memcmp(existing.msh_pubkey_fp, fp, sizeof(existing.msh_pubkey_fp)) != 0;
+
+    gLinkRecord.version = kLinkRecordVersion;
+    gLinkRecord.mode = mode;
+    gLinkRecord.msh_node_num = nodeNum;
+    memcpy(gLinkRecord.mc_pubkey, mcPubKey, sizeof(gLinkRecord.mc_pubkey));
+    memcpy(gLinkRecord.msh_pubkey_fp, fp, sizeof(gLinkRecord.msh_pubkey_fp));
+    gLinkRecord.updated = changed ? nowSec : existing.updated;
+
+    if (changed) {
+        Preferences prefs;
+        if (prefs.begin("raumata", false)) {
+            prefs.putBytes("link", &gLinkRecord, sizeof(gLinkRecord));
+            prefs.end();
+        }
+    }
+
+    if (changed && emitNotification && service) {
+        meshtastic_ClientNotification *cn = clientNotificationPool.allocZeroed();
+        if (cn) {
+            cn->level = meshtastic_LogRecord_Level_INFO;
+            cn->time = getValidTime(RTCQualityFromNet);
+            formatLinkSummary(cn->message, sizeof(cn->message));
+            service->sendClientNotification(cn);
+        }
+    }
+
+    return changed;
+}
+
+void formatCustomVars(char *dest, size_t destSize)
+{
+    if (!dest || destSize == 0) {
+        return;
+    }
+
+    char mshFpHex[17];
+    char mcPrefixHex[17];
+    mesh::Utils::toHex(mshFpHex, gLinkRecord.msh_pubkey_fp, sizeof(gLinkRecord.msh_pubkey_fp));
+    mesh::Utils::toHex(mcPrefixHex, gLinkRecord.mc_pubkey, 8);
+
+    const PhyProfile &phy = activePhyProfile();
+    snprintf(dest, destSize, "msh.node:%08x,msh.pubkey:%s,mc.pubkey:%s,phy.id:%u,phy.name:%s,phy.sync:%02X",
+             static_cast<unsigned int>(gLinkRecord.msh_node_num), mshFpHex, mcPrefixHex, phy.id, phy.name,
+             activeSyncWord());
+}
+
+void formatLinkSummary(char *dest, size_t destSize)
+{
+    if (!dest || destSize == 0) {
+        return;
+    }
+
+    char mshFpHex[17];
+    char mcPrefixHex[17];
+    mesh::Utils::toHex(mshFpHex, gLinkRecord.msh_pubkey_fp, sizeof(gLinkRecord.msh_pubkey_fp));
+    mesh::Utils::toHex(mcPrefixHex, gLinkRecord.mc_pubkey, 8);
+
+    const char *modeStr = gLinkRecord.mode == RAUMATA_ID_DERIVED ? "derived" : "independent";
+    snprintf(dest, destSize, "raumata.link mode=%s msh=!%08x fp=%s mc=%s", modeStr,
+             static_cast<unsigned int>(gLinkRecord.msh_node_num), mshFpHex, mcPrefixHex);
+}
+
+} // namespace raumata
+
+#endif // RAUMATA_DUAL_PROTOCOL
