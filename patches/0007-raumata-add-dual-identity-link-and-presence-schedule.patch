+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace raumata {
+
+enum RaumataIdentityMode : uint8_t {
+    RAUMATA_ID_INDEPENDENT = 0,
+    RAUMATA_ID_DERIVED = 1,
+    RAUMATA_ID_CROSS_SIGNED = 2,
+};
+
+struct RaumataLinkRecord {
+    uint8_t version;          // 1
+    uint8_t mode;             // RaumataIdentityMode
+    uint32_t msh_node_num;    // Meshtastic NodeNum
+    uint8_t mc_pubkey[32];    // MeshCore Ed25519 public key
+    uint8_t msh_pubkey_fp[8]; // Truncated SHA-256 of Meshtastic Curve25519 public key
+    uint32_t updated;         // RTC timestamp when last updated
+};
+
+constexpr uint8_t kLinkRecordVersion = 1;
+
+/// Compute the 8-byte SHA-256 fingerprint of the active Meshtastic public key.
+void computeMeshtasticPubKeyFingerprint(uint8_t fp[8]);
+
+/// Derive a deterministic 32-byte Ed25519 seed from the Meshtastic private key (Mode B).
+bool deriveMeshCoreSeed(uint8_t seed[32]);
+
+/// Load the saved link record from NVS, if present.
+bool loadLinkRecord(RaumataLinkRecord &out);
+
+/// Return the active in-memory link record.
+const RaumataLinkRecord &activeLinkRecord();
+
+/// Synchronize the link record with the current Meshtastic NodeDB and MeshCore public key.
+/// Returns true if the link record changed and was persisted to NVS.
+bool syncIdentityLink(const uint8_t mcPubKey[32], uint32_t nowSec, bool emitNotification = true);
+
+/// Format link and PHY custom variables as comma-separated key:value pairs for CMD_GET_CUSTOM_VARS.
+void formatCustomVars(char *dest, size_t destSize);
+
+/// Format a human-readable summary of the identity link for CLI queries.
+void formatLinkSummary(char *dest, size_t destSize);
+
+} // namespace raumata
