@@ -0,0 +1,112 @@
+#ifdef RAUMATA_DUAL_PROTOCOL
+#include "PresenceScheduler.h"
+
+#include <Arduino.h>
+
+#include "MeshCoreNode.h"
+#include "airtime.h"
+#include "mesh/MeshRadio.h"
+#include "modules/NodeInfoModule.h"
+
+namespace raumata {
+
+void PresenceScheduler::begin(MeshCoreNode &node)
+{
+    bootMs_ = millis();
+    const uint8_t *pub = node.identity().pub_key;
+    uint16_t seed = static_cast<uint16_t>((static_cast<uint16_t>(pub[0]) << 8) | pub[1]);
+    // 30 s offset + 0..30 s deterministic jitter derived from node identity
+    jitterMs_ = 30000UL + (static_cast<uint32_t>(seed) % 30000UL);
+
+    nextMeshCoreAdvertMs_ = bootMs_ + kBootMeshCoreDelayMs;
+    nextMeshtasticNodeInfoMs_ = bootMs_ + kBootMeshtasticDelayMs;
+    bootMeshCoreSent_ = false;
+    bootMeshtasticSent_ = false;
+    pendingReAdvertMeshCore_ = false;
+    pendingReAdvertMeshtastic_ = false;
+}
+
+void PresenceScheduler::loop(MeshCoreNode &node)
+{
+    uint32_t now = millis();
+
+    if (!bootMeshCoreSent_ && static_cast<int32_t>(now - nextMeshCoreAdvertMs_) >= 0) {
+        bootMeshCoreSent_ = true;
+        if (canSendBackgroundAdvert(250)) {
+            node.sendSelfAdvert(true);
+        }
+        nextMeshCoreAdvertMs_ = now + kPeriodicIntervalMs + jitterMs_;
+    }
+
+    if (!bootMeshtasticSent_ && static_cast<int32_t>(now - nextMeshtasticNodeInfoMs_) >= 0) {
+        bootMeshtasticSent_ = true;
+        if (nodeInfoModule && canSendBackgroundAdvert(250)) {
+            nodeInfoModule->sendOurNodeInfo(NODENUM_BROADCAST, false, 0, true);
+        }
+    }
+
+    if (bootMeshCoreSent_ && pendingReAdvertMeshCore_ && static_cast<int32_t>(now - nextMeshCoreAdvertMs_) >= 0) {
+        pendingReAdvertMeshCore_ = false;
+        if (canSendBackgroundAdvert(250)) {
+            node.sendSelfAdvert(true);
+        }
+        nextMeshCoreAdvertMs_ = now + kPeriodicIntervalMs + jitterMs_;
+    }
+
+    if (bootMeshtasticSent_ && pendingReAdvertMeshtastic_ &&
+        static_cast<int32_t>(now - nextMeshtasticNodeInfoMs_) >= 0) {
+        pendingReAdvertMeshtastic_ = false;
+        if (nodeInfoModule && canSendBackgroundAdvert(250)) {
+            nodeInfoModule->sendOurNodeInfo(NODENUM_BROADCAST, false, 0, true);
+        }
+    }
+
+    if (bootMeshCoreSent_ && !pendingReAdvertMeshCore_ && static_cast<int32_t>(now - nextMeshCoreAdvertMs_) >= 0) {
+        if (canSendBackgroundAdvert(250)) {
+            node.sendSelfAdvert(true);
+        }
+        nextMeshCoreAdvertMs_ = now + kPeriodicIntervalMs + jitterMs_;
+    }
+}
+
+void PresenceScheduler::scheduleReAdvertise()
+{
+    uint32_t now = millis();
+    if (lastReAdvertMs_ != 0 && (now - lastReAdvertMs_) < kReAdvertCooldownMs) {
+        return;
+    }
+    lastReAdvertMs_ = now;
+    pendingReAdvertMeshCore_ = true;
+    pendingReAdvertMeshtastic_ = true;
+    nextMeshCoreAdvertMs_ = now + 5000UL;
+    nextMeshtasticNodeInfoMs_ = now + 10000UL;
+}
+
+float PresenceScheduler::meshCoreBudgetFactor()
+{
+    // Dispatcher uses duty_cycle = 1.0f / (1.0f + getAirtimeBudgetFactor()).
+    // Cap total channel TX utilization to the regional duty cycle (or 10% for
+    // unrestricted regions) and give MeshCore kDefaultMeshCoreShare (25%).
+    float regionDuty = (myRegion && myRegion->dutyCycle > 0.0f && myRegion->dutyCycle < 100.0f)
+                           ? (myRegion->dutyCycle / 100.0f)
+                           : 0.10f;
+    float mcDuty = regionDuty * kDefaultMeshCoreShare;
+    if (mcDuty <= 0.0005f) {
+        mcDuty = 0.0005f;
+    }
+    float factor = (1.0f / mcDuty) - 1.0f;
+    return factor < 1.0f ? 1.0f : factor;
+}
+
+bool PresenceScheduler::canSendBackgroundAdvert(uint32_t estAirtimeMs)
+{
+    (void)estAirtimeMs;
+    if (!airTime) {
+        return true;
+    }
+    return airTime->isTxAllowedChannelUtil(true) && airTime->isTxAllowedAirUtil();
+}
+
+} // namespace raumata
+
+#endif // RAUMATA_DUAL_PROTOCOL
diff --git a/src/raumata/PresenceScheduler.h b/src/raumata/PresenceScheduler.h
new file mode 100644
index 0000000000000000000000000000000000000000..6588c27e391790435f84ca137d1278984c0826e8
--- /dev/null
+++ b/src/raumata/PresenceScheduler.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <cstdint>
+
+namespace raumata {
+
+class MeshCoreNode;
+
+/**
+ * Shared airtime policy and staggered presence scheduler for Meshtastic + MeshCore.
+ *
+ * - Staggers boot announcements (MeshCore advert at T+15 s, Meshtastic NodeInfo at T+20 s).
+ * - Schedules periodic MeshCore adverts every 15 minutes with deterministic per-node
+ *   jitter so dual nodes do not synchronize bursts.
+ * - Rate-limits re-advertisements triggered by PHY profile or owner changes.
+ * - Computes the MeshCore Dispatcher airtime budget factor so MeshCore stays within its
+ *   allocated share (default 25%) of the regional duty cycle.
+ */
+class PresenceScheduler
+{
+  public:
+    static constexpr uint32_t kBootMeshCoreDelayMs = 15UL * 1000UL;
+    static constexpr uint32_t kBootMeshtasticDelayMs = 20UL * 1000UL;
+    static constexpr uint32_t kPeriodicIntervalMs = 15UL * 60UL * 1000UL;
+    static constexpr uint32_t kReAdvertCooldownMs = 60UL * 1000UL;
+    static constexpr float kDefaultMeshCoreShare = 0.25f;
+
+    void begin(MeshCoreNode &node);
+    void loop(MeshCoreNode &node);
+
+    /// Schedule a staggered re-advertisement on both stacks after a PHY or identity change.
+    void scheduleReAdvertise();
+
+    /// Compute the Dispatcher airtime budget factor for the MeshCore stack.
+    static float meshCoreBudgetFactor();
