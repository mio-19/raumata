+
+bool RaumataRadioDriver::setParams(float freq, float bw, uint8_t sf, uint8_t cr)
+{
+    return raumata::acceptCompanionRadio(freq, bw, sf, cr);
+}
+
+void RaumataRadioDriver::setTxPower(uint8_t dbm)
+{
+    if (raumata::activePhyProfile().tx_power == static_cast<int8_t>(dbm)) {
+        return;
+    }
+    raumata::applyTxPower(static_cast<int8_t>(dbm));
+}
+
+bool RaumataRadioDriver::setRxBoostedGainMode(bool enabled)
+{
+    if (config.lora.sx126x_rx_boosted_gain == enabled) {
+        return true;
+    }
+    config.lora.sx126x_rx_boosted_gain = enabled;
+    return raumata::applyTxPower(raumata::activePhyProfile().tx_power);
+}
+
+bool RaumataRadioDriver::getRxBoostedGainMode() const
+{
+    return config.lora.sx126x_rx_boosted_gain;
+}
+
+float RaumataRadioDriver::getLastRSSI() const
+{
+    return radio_ ? radio_->getLastRSSI() : 0.0f;
+}
+
+float RaumataRadioDriver::getLastSNR() const
+{
+    return radio_ ? radio_->getLastSNR() : 0.0f;
+}
+
+uint32_t RaumataRadioDriver::getPacketsRecv() const
+{
+    return radio_ ? radio_->packetsRecv() : 0;
+}
+
+uint32_t RaumataRadioDriver::getPacketsSent() const
+{
+    return radio_ ? radio_->packetsSent() : 0;
+}
+
+uint32_t RaumataRadioDriver::getPacketsRecvErrors() const
+{
+    return radio_ ? radio_->packetsRecvErrors() : 0;
+}
+
+uint16_t RaumataBoard::getBattMilliVolts()
+{
+    if (powerStatus) {
+        int mv = powerStatus->getBatteryVoltageMv();
+        if (mv > 0) {
+            return static_cast<uint16_t>(mv);
+        }
+    }
+    return 0;
+}
+
+const char *RaumataBoard::getManufacturerName() const
+{
+    return "Raumata";
+}
+
+void RaumataBoard::reboot()
+{
+    ESP.restart();
+}
+
+uint8_t RaumataBoard::getStartupReason() const
+{
+    return BD_STARTUP_NORMAL;
+}
+
+bool RaumataBoard::handleCommand(const char *, uint32_t, char[])
+{
+    return false;
+}
+
+mesh::LocalIdentity radio_new_identity()
+{
+    class FillRng : public mesh::RNG
+    {
+      public:
+        void random(uint8_t *dest, size_t sz) override { esp_fill_random(dest, sz); }
+    };
+
+    FillRng rng;
+    return mesh::LocalIdentity(&rng);
+}
+
+#endif // RAUMATA_DUAL_PROTOCOL
