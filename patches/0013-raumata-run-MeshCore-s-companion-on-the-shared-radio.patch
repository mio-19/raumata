+}
+
+// Shim in front of the single Raumata radio. MeshCore companion commands
+// land here instead of programming a second SX1262.
+class RaumataRadioDriver
+{
+  public:
+    bool setParams(float freq, float bw, uint8_t sf, uint8_t cr);
+    void setTxPower(uint8_t dbm);
+    bool setRxBoostedGainMode(bool enabled);
+    bool getRxBoostedGainMode() const;
+    float getLastRSSI() const;
+    float getLastSNR() const;
+    uint32_t getPacketsRecv() const;
+    uint32_t getPacketsSent() const;
+    uint32_t getPacketsRecvErrors() const;
+
+    void bind(class raumata::MeshCoreRadio *radio) { radio_ = radio; }
+
+  private:
+    raumata::MeshCoreRadio *radio_ = nullptr;
+};
+
+class RaumataBoard : public mesh::MainBoard
+{
+  public:
+    uint16_t getBattMilliVolts() override;
+    const char *getManufacturerName() const override;
+    void reboot() override;
+    uint8_t getStartupReason() const override;
+    bool handleCommand(const char *command, uint32_t sender_timestamp, char reply[]);
+    void attachDynamicPrefs(KeyValueStore *) {}
+};
