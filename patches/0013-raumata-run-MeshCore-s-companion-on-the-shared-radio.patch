diff --git a/src/raumata/companion/CayenneLPP.h b/src/raumata/companion/CayenneLPP.h
new file mode 100644
index 0000000000000000000000000000000000000000..9a10bc5f564b28bfc279e6da45dbd15f3497f318
--- /dev/null
+++ b/src/raumata/companion/CayenneLPP.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+// Minimal CayenneLPP encoder used by the MeshCore companion telemetry replies.
+class CayenneLPP
+{
+  public:
+    explicit CayenneLPP(uint8_t size) : cap_(size), len_(0), buf_(new uint8_t[size]) {}
+    ~CayenneLPP() { delete[] buf_; }
+
+    CayenneLPP(const CayenneLPP &) = delete;
+    CayenneLPP &operator=(const CayenneLPP &) = delete;
+
+    void reset() { len_ = 0; }
+
+    void addVoltage(uint8_t channel, float volts)
+    {
+        int16_t raw = static_cast<int16_t>(volts * 100.0f);
+        add(channel, 116, raw);
+    }
+
+    void addTemperature(uint8_t channel, float celsius)
+    {
+        int16_t raw = static_cast<int16_t>(celsius * 10.0f);
+        add(channel, 103, raw);
+    }
+
+    uint8_t getSize() const { return len_; }
+    uint8_t *getBuffer() { return buf_; }
+
+  private:
+    void add(uint8_t channel, uint8_t type, int16_t raw)
+    {
+        if (len_ + 4 > cap_) {
+            return;
+        }
+        buf_[len_++] = channel;
+        buf_[len_++] = type;
+        buf_[len_++] = static_cast<uint8_t>(raw >> 8);
+        buf_[len_++] = static_cast<uint8_t>(raw & 0xFF);
+    }
+
+    uint8_t cap_;
+    uint8_t len_;
+    uint8_t *buf_;
+};
diff --git a/src/raumata/companion/CompanionHooks.cpp b/src/raumata/companion/CompanionHooks.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..76513f27dd7e2fcfa5d3d3957f622f60c57002c3
--- /dev/null
+++ b/src/raumata/companion/CompanionHooks.cpp
@@ -0,0 +1,261 @@
+#include "configuration.h"
+#if defined(RAUMATA_DUAL_PROTOCOL)
+
+#include "CompanionHooks.h"
+
+#include <Arduino.h>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include <helpers/BaseSerialInterface.h>
+
+#include "mesh/NodeDB.h"
+#include "mesh/RadioInterface.h"
+#include "raumata/CompanionProtocol.h"
+#include "raumata/IdentityLink.h"
+#include "raumata/OperatingMode.h"
+#include "raumata/PhyProfile.h"
+#include "raumata/PresenceScheduler.h"
+#include "target.h"
+
+namespace raumata {
+namespace {
+
+using namespace protocol;
+
+void writeBytes(BaseSerialInterface *serial, const uint8_t *frame, size_t len)
+{
+    if (serial) {
+        serial->writeFrame(frame, len);
+    }
+}
+
+void writeOk(BaseSerialInterface *serial)
+{
+    uint8_t code = RESP_CODE_OK;
+    writeBytes(serial, &code, 1);
+}
+
+void writeErr(BaseSerialInterface *serial, uint8_t err)
+{
+    uint8_t buf[2] = {RESP_CODE_ERR, err};
+    writeBytes(serial, buf, 2);
+}
+
+bool gCoordOverride = false;
+
+} // namespace
+
+float meshCoreBudgetFactor()
+{
+    return PresenceScheduler::meshCoreBudgetFactor();
+}
+
+void syncCompanionRadioPrefs(float &freq, float &bw, uint8_t &sf, uint8_t &cr, int8_t &txPower)
+{
+    const PhyProfile &phy = activePhyProfile();
+    freq = phy.freq_mhz;
+    bw = phy.bw_khz;
+    sf = phy.sf;
+    cr = phy.cr;
+    txPower = phy.tx_power;
+    if (RadioInterface *radio = boundRadio()) {
+        if (radio->getFreq() > 1.0f) {
+            freq = radio->getFreq();
+        }
+        if (radio->getBandwidthKHz() > 1.0f) {
+            bw = radio->getBandwidthKHz();
+        }
+        sf = radio->getSpreadFactorValue();
+        cr = radio->getCodingRateValue();
+        txPower = radio->getTxPower();
+    }
+}
+
+bool acceptCompanionRadio(float freqMhz, float bwKhz, uint8_t sf, uint8_t cr)
+{
+    float activeFreq = 0;
+    float activeBw = 0;
+    uint8_t activeSf = 0;
+    uint8_t activeCr = 0;
+    int8_t txPower = activePhyProfile().tx_power;
+    syncCompanionRadioPrefs(activeFreq, activeBw, activeSf, activeCr, txPower);
+    if (fabsf(activeFreq - freqMhz) < 0.02f && fabsf(activeBw - bwKhz) < 1.0f && activeSf == sf && activeCr == cr) {
+        return true;
+    }
+    return applyCustomPhyProfile(freqMhz, bwKhz, sf, cr, activeSyncWord(), activePreambleLength(), txPower);
+}
+
+bool applyCompanionSetting(const char *key, const char *value, char *nodeName, size_t nodeNameLen)
+{
+    if (!key || !value) {
+        return false;
+    }
+    if (strcmp(key, "mode") == 0) {
+        OperatingMode mode;
+        return parseOperatingModeName(value, mode) && applyOperatingMode(mode);
+    }
+    if (strcmp(key, "phy.id") == 0 || strcmp(key, "phy_profile") == 0) {
+        return applyPhyProfile(static_cast<uint8_t>(strtoul(value, nullptr, 10)));
+    }
+    if (strcmp(key, "mc.name") == 0 && value[0] != 0 && nodeName && nodeNameLen > 1) {
+        strncpy(nodeName, value, nodeNameLen - 1);
+        nodeName[nodeNameLen - 1] = 0;
+        return true;
+    }
+    return false;
+}
+
+void appendCompanionCustomVars(char *dest, size_t destSize)
+{
+    if (!dest || destSize == 0) {
+        return;
+    }
+    formatCustomVars(dest, destSize);
+}
+
+void noteCompanionCoordOverride()
+{
+    gCoordOverride = true;
+}
+
+void setCompanionCoords(double lat, double lon)
+{
+    sensors.node_lat = lat;
+    sensors.node_lon = lon;
+    gCoordOverride = true;
+}
+
+void refreshCompanionLocation(double &lat, double &lon)
+{
+    if (gCoordOverride) {
+        lat = sensors.node_lat;
+        lon = sensors.node_lon;
+        return;
+    }
+    if (localPosition.latitude_i != 0 || localPosition.longitude_i != 0) {
+        lat = static_cast<double>(localPosition.latitude_i) * 1e-7;
+        lon = static_cast<double>(localPosition.longitude_i) * 1e-7;
+        sensors.node_lat = lat;
+        sensors.node_lon = lon;
+    }
+}
+
+bool handleCompanionExtension(const uint8_t *frame, size_t len, BaseSerialInterface *serial)
+{
+    if (!frame || len == 0) {
+        return false;
+    }
+
+    if (frame[0] == CMD_GET_PHY_PROFILES) {
+        size_t count = 0;
+        const PhyProfile *table = getPhyPresetTable(count);
+        uint8_t out[MAX_FRAME_SIZE];
+        uint8_t listed = 0;
+        for (size_t i = 0; i < count; i++) {
+            if (profileKindAllowed(static_cast<uint8_t>(table[i].kind))) {
+                listed++;
+            }
+        }
+        int n = 0;
+        out[n++] = RESP_CODE_PHY_PROFILES;
+        out[n++] = activePhyProfile().id;
+        out[n++] = listed;
+        for (size_t i = 0; i < count; i++) {
+            const PhyProfile &profile = table[i];
+            if (!profileKindAllowed(static_cast<uint8_t>(profile.kind)) || n + 15 > static_cast<int>(sizeof(out))) {
+                continue;
+            }
+            out[n++] = profile.id;
+            out[n++] = static_cast<uint8_t>(profile.kind);
+            out[n++] = profile.sync_word;
+            out[n++] = profile.sf;
+            out[n++] = profile.cr;
+            memcpy(&out[n], &profile.preamble, 2);
+            n += 2;
+            uint32_t freqKhz = static_cast<uint32_t>(profile.freq_mhz * 1000.0f);
+            uint32_t bwHz = static_cast<uint32_t>(profile.bw_khz * 1000.0f);
+            memcpy(&out[n], &freqKhz, 4);
+            n += 4;
+            memcpy(&out[n], &bwHz, 4);
+            n += 4;
+        }
+        writeBytes(serial, out, n);
+        return true;
+    }
+
+    if (frame[0] == CMD_GET_PHY_PROFILE) {
+        const PhyProfile &profile = activePhyProfile();
+        float freq = profile.freq_mhz;
+        float bw = profile.bw_khz;
+        uint8_t sf = profile.sf;
+        uint8_t cr = profile.cr;
+        int8_t txPower = profile.tx_power;
+        syncCompanionRadioPrefs(freq, bw, sf, cr, txPower);
+        uint8_t out[MAX_FRAME_SIZE];
+        int n = 0;
+        out[n++] = RESP_CODE_PHY_PROFILE;
+        out[n++] = profile.id;
+        out[n++] = static_cast<uint8_t>(profile.kind);
+        uint32_t freqKhz = static_cast<uint32_t>(freq * 1000.0f);
+        uint32_t bwHz = static_cast<uint32_t>(bw * 1000.0f);
+        memcpy(&out[n], &freqKhz, 4);
+        n += 4;
+        memcpy(&out[n], &bwHz, 4);
+        n += 4;
+        out[n++] = sf;
+        out[n++] = cr;
+        out[n++] = activeSyncWord();
+        uint16_t preamble = activePreambleLength();
+        memcpy(&out[n], &preamble, 2);
+        n += 2;
+        out[n++] = static_cast<uint8_t>(txPower);
+        size_t nameLen = strlen(profile.name);
+        if (n + static_cast<int>(nameLen) > static_cast<int>(sizeof(out))) {
+            nameLen = sizeof(out) - n;
+        }
+        memcpy(&out[n], profile.name, nameLen);
+        n += static_cast<int>(nameLen);
+        writeBytes(serial, out, n);
+        return true;
+    }
+
+    if (frame[0] != CMD_SET_PHY_PROFILE) {
+        return false;
+    }
+
+    if (len < 2) {
+        writeErr(serial, ERR_CODE_ILLEGAL_ARG);
+        return true;
+    }
+    uint8_t id = frame[1];
+    bool ok = false;
+    if (id == kPhyProfileCustomId && len >= 15) {
+        uint32_t freqKhz = 0;
+        uint32_t bwHz = 0;
+        memcpy(&freqKhz, &frame[2], 4);
+        memcpy(&bwHz, &frame[6], 4);
+        uint8_t sf = frame[10];
+        uint8_t cr = frame[11];
+        uint8_t sync = frame[12];
+        uint16_t preamble = 0;
+        memcpy(&preamble, &frame[13], 2);
+        int8_t txPower = len >= 16 ? static_cast<int8_t>(frame[15]) : activePhyProfile().tx_power;
+        ok = applyCustomPhyProfile(static_cast<float>(freqKhz) / 1000.0f, static_cast<float>(bwHz) / 1000.0f, sf, cr,
+                                   sync, preamble, txPower);
+    } else if (id != kPhyProfileCustomId) {
+        ok = applyPhyProfile(id);
+    }
+    if (ok) {
+        writeOk(serial);
+    } else {
+        writeErr(serial, id == kPhyProfileCustomId ? ERR_CODE_ILLEGAL_ARG : ERR_CODE_NOT_FOUND);
+    }
+    return true;
+}
+
+} // namespace raumata
+
+#endif // RAUMATA_DUAL_PROTOCOL
