 #include "mesh/NodeDB.h"
 #include "mesh/generated/meshtastic/mesh.pb.h"
 
@@ -28,6 +29,49 @@ constexpr float kSharedShare = 0.50f;
 OperatingMode gMode = MODE_SHARED_MESHTASTIC_PHY;
 uint8_t gLastMeshtasticId = 0;
 uint8_t gLastMeshCoreId = 0;
+uint32_t gMeshtasticTxMs[60] = {};
+uint32_t gMeshCoreTxMs[60] = {};
+uint8_t gAirtimeMinute = 0xFF;
+
+void rotateAirtimeBuckets()
+{
+    const uint8_t minute = static_cast<uint8_t>((millis() / 60000UL) % 60UL);
+    if (gAirtimeMinute == 0xFF) {
+        gAirtimeMinute = minute;
+        return;
+    }
+    while (gAirtimeMinute != minute) {
+        gAirtimeMinute = static_cast<uint8_t>((gAirtimeMinute + 1) % 60);
+        gMeshtasticTxMs[gAirtimeMinute] = 0;
+        gMeshCoreTxMs[gAirtimeMinute] = 0;
+    }
+}
+
+uint32_t sumBuckets(const uint32_t buckets[60])
+{
+    uint32_t total = 0;
+    for (int i = 0; i < 60; i++) {
+        total += buckets[i];
+    }
+    return total;
+}
+
+float regionalDutyFraction()
+{
+    if (myRegion && myRegion->dutyCycle > 0.0f && myRegion->dutyCycle < 100.0f) {
+        return myRegion->dutyCycle / 100.0f;
+    }
+    return 0.10f;
+}
+
+uint32_t hourlyBudgetMs(float share)
+{
+    const float ms = regionalDutyFraction() * 3600000.0f * share;
+    if (ms < 1000.0f) {
+        return 1000;
+    }
+    return static_cast<uint32_t>(ms);
+}
 
 bool validMode(uint8_t mode)
 {
@@ -176,12 +220,48 @@ bool meshtasticPresenceEnabled()
     return gMode != MODE_MAINLY_MESHCORE;
 }
 
-bool meshtasticPacketMayTransmit(uint8_t priority)
+void noteStackAirtime(bool meshcore, uint32_t airtimeMs)
+{
+    if (airtimeMs == 0) {
+        return;
+    }
+    rotateAirtimeBuckets();
+    uint32_t *bucket = meshcore ? &gMeshCoreTxMs[gAirtimeMinute] : &gMeshtasticTxMs[gAirtimeMinute];
+    *bucket += airtimeMs;
+}
+
+bool meshCoreAirtimeAllows(uint32_t estAirtimeMs)
+{
+    rotateAirtimeBuckets();
+    return sumBuckets(gMeshCoreTxMs) + estAirtimeMs <= hourlyBudgetMs(meshCoreAirtimeShare());
+}
+
+bool meshtasticAirtimeAllows(uint32_t estAirtimeMs)
 {
-    if (meshtasticPresenceEnabled()) {
+    rotateAirtimeBuckets();
+    const float share = 1.0f - meshCoreAirtimeShare();
+    return sumBuckets(gMeshtasticTxMs) + estAirtimeMs <= hourlyBudgetMs(share);
+}
+
+bool meshtasticPacketMayTransmit(uint8_t portnum, uint8_t priority, uint32_t estAirtimeMs)
+{
+    const bool essential = portnum == meshtastic_PortNum_TEXT_MESSAGE_APP ||
+                           portnum == meshtastic_PortNum_ROUTING_APP || portnum == meshtastic_PortNum_ADMIN_APP;
+    if (essential) {
         return true;
     }
-    return priority >= meshtastic_MeshPacket_Priority_DEFAULT;
+
+    const bool presenceTraffic = portnum == meshtastic_PortNum_NODEINFO_APP ||
+                                 portnum == meshtastic_PortNum_POSITION_APP ||
+                                 portnum == meshtastic_PortNum_TELEMETRY_APP ||
+                                 priority < meshtastic_MeshPacket_Priority_DEFAULT;
+    if (!meshtasticPresenceEnabled() && presenceTraffic) {
+        return false;
+    }
+    if (presenceTraffic) {
+        return meshtasticAirtimeAllows(estAirtimeMs);
+    }
+    return true;
 }
 
 bool profileKindAllowed(uint8_t kind)
