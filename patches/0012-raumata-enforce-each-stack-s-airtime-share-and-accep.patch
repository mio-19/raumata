-void MeshCoreNode::sendSelfAdvert(bool flood)
+void MeshCoreNode::loadCoords()
+{
+    Preferences prefs;
+    if (!prefs.begin("raumata", true)) {
+        return;
+    }
+    int32_t stored[2] = {};
+    size_t len = prefs.getBytesLength("mc_ll");
+    bool ok = len == sizeof(stored) && prefs.getBytes("mc_ll", stored, sizeof(stored)) == sizeof(stored);
+    prefs.end();
+    if (!ok) {
+        return;
+    }
+    latE6_ = stored[0];
+    lonE6_ = stored[1];
+    hasCoordOverride_ = true;
+}
+
+void MeshCoreNode::saveCoords()
+{
+    int32_t stored[2] = {latE6_, lonE6_};
+    Preferences prefs;
+    if (prefs.begin("raumata", false)) {
+        prefs.putBytes("mc_ll", stored, sizeof(stored));
+        prefs.end();
+    }
+}
+
+mesh::Packet *MeshCoreNode::createLocatedAdvert()
 {
-    mesh::Packet *packet = nullptr;
+    if (hasCoordOverride_) {
+        return createSelfAdvert(nodeName_, static_cast<double>(latE6_) / 1000000.0, static_cast<double>(lonE6_) / 1000000.0);
+    }
     if (localPosition.latitude_i != 0 || localPosition.longitude_i != 0) {
         double lat = static_cast<double>(localPosition.latitude_i) * 1e-7;
         double lon = static_cast<double>(localPosition.longitude_i) * 1e-7;
-        packet = createSelfAdvert(nodeName_, lat, lon);
-    } else {
-        packet = createSelfAdvert(nodeName_);
+        return createSelfAdvert(nodeName_, lat, lon);
     }
+    return createSelfAdvert(nodeName_);
+}
 
+void MeshCoreNode::sendSelfAdvert(bool flood)
+{
+    mesh::Packet *packet = createLocatedAdvert();
     if (!packet) {
         return;
     }
@@ -1033,6 +1067,26 @@ void MeshCoreNode::handleCommand(uint8_t command, const uint8_t *frame, size_t l
         }
         break;
 
