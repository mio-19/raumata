+    }
+#endif
+
 #ifdef HELTEC_MESH_SOLAR
     // After enabling the mesh solar serial port module configuration, command processing is handled by the serial port module.
     if (moduleConfig.serial.enabled && moduleConfig.serial.override_console_serial_port &&
@@ -129,6 +139,7 @@ bool SerialConsole::handleToRadio(const uint8_t *buf, size_t len)
 {
     // only talk to the API once the configuration has been loaded and we're sure the serial port is not disabled.
     if (config.has_lora && config.security.serial_enabled) {
+        meshCoreSerialMode = false;
         // Switch to protobufs for log messages
         usingProtobufs = true;
         canWrite = true;
@@ -139,8 +150,18 @@ bool SerialConsole::handleToRadio(const uint8_t *buf, size_t len)
     }
 }
 
+void SerialConsole::setMeshCoreSerialMode(bool enabled)
+{
+    meshCoreSerialMode = enabled;
+    canWrite = !enabled;
+}
+
 void SerialConsole::log_to_serial(const char *logLevel, const char *format, va_list arg)
 {
+    if (meshCoreSerialMode) {
+        return;
+    }
+
     if (usingProtobufs && config.security.debug_log_api_enabled) {
         meshtastic_LogRecord_Level ll = RedirectablePrint::getLogLevel(logLevel);
         auto thread = concurrency::OSThread::currentThread;
