 #define IS_USB_SERIAL
 #ifdef SERIAL_HAS_ON_RECEIVE
@@ -80,6 +84,12 @@ SerialConsole::SerialConsole() : StreamAPI(&Port), RedirectablePrint(&Port), con
 
 int32_t SerialConsole::runOnce()
 {
+#ifdef RAUMATA_DUAL_PROTOCOL
+    if (raumata::serialMuxActive()) {
