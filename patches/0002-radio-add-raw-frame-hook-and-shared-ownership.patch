-    int32_t getNoiseFloor();
+    int32_t getNoiseFloor() override;
 
     /**
      * Calculate the average noise floor from collected samples
@@ -197,6 +200,23 @@ class RadioLibInterface : public RadioInterface, protected concurrency::Notified
      */
     virtual bool isSending();
 
+    uint8_t getSyncWord() const override { return syncWord; }
+    void setSyncWord(uint8_t sw) override { syncWord = sw; }
+
+    /// Raw-frame access used by the dual-protocol MeshCore stack.
+    void setRawPacketHandler(RawPacketHandler *handler) override { rawPacketHandler = handler; }
+    bool rawTransmit(const uint8_t *data, size_t len) override;
+    bool rawTransmitDone() const override { return rawTxDone.load(std::memory_order_acquire); }
+    void rawTransmitFinished() override { rawTxDone.store(false, std::memory_order_release); }
+    bool rawTransmitActive() const override { return rawTxActive.load(std::memory_order_acquire); }
+    bool isChannelBusy() override
+    {
+        return sendingPacket != nullptr || rawTxActive.load(std::memory_order_acquire) ||
+               (isReceiving && isActivelyReceiving());
+    }
+    float getLastRssi() const override { return lastRawRssi; }
+    float getLastSnr() const override { return lastRawSnr; }
+
     /** Attempt to cancel a previously sent packet.  Returns true if a packet was found we could cancel */
     virtual bool cancelSending(NodeNum from, PacketId id) override;
 
@@ -232,6 +252,14 @@ class RadioLibInterface : public RadioInterface, protected concurrency::Notified
     bool randomBytes(uint8_t *buffer, size_t length);
 
   private:
+    RawPacketHandler *rawPacketHandler = nullptr;
+    std::atomic<bool> rawTxActive{false};
+    std::atomic<bool> rawTxDone{false};
+    uint16_t rawTxBytes = 0;
+    volatile float lastRawSnr = 0;
+    volatile float lastRawRssi = 0;
+    std::mutex rawRadioMutex;
+
     uint8_t getNoiseFloorSampleCountInternal() const;
     int32_t getAverageNoiseFloorInternal() const;
 
