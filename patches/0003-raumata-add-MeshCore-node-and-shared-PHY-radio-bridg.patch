+void MeshCoreNode::onChannelMessageRecv(const mesh::GroupChannel &channel, mesh::Packet *packet, uint32_t timestamp,
+                                        const char *text)
+{
+    int channelIdx = findChannelIdx(channel);
+    if (channelIdx < 0) {
+        channelIdx = 0;
+    }
+
+    QueuedMessage message = {};
+    message.type = 0;
+    message.snr4 = static_cast<int8_t>(packet ? packet->getSNR() * 4.0f : 0);
+    message.channel = static_cast<uint8_t>(channelIdx);
+    message.pathLen = packet && packet->isRouteFlood() ? static_cast<uint8_t>(packet->path_len) : 0xFF;
+    message.txtType = RAUMATA_TXT_TYPE_PLAIN;
+    message.timestamp = timestamp;
+
+    size_t len = strlen(text);
+    if (len > MAX_TEXT_LEN) {
+        len = MAX_TEXT_LEN;
+    }
+    message.textLen = static_cast<uint16_t>(len);
+    memcpy(message.text, text, len);
+    message.text[len] = 0;
+
+    enqueueMessage(message);
+}
