+
+MeshCoreNode::MeshCoreNode(mesh::Radio &radio, mesh::MillisecondClock &ms, mesh::RNG &rng, mesh::RTCClock &rtc,
+                           mesh::PacketManager &mgr, mesh::MeshTables &tables, RadioInterface &meshtasticRadio,
+                           FrameWriter writer)
+    : BaseChatMesh(radio, ms, rng, rtc, mgr, tables), meshtasticRadio_(meshtasticRadio), writer_(std::move(writer))
+{
+    memset(nodeName_, 0, sizeof(nodeName_));
+    strncpy(nodeName_, "Raumata", sizeof(nodeName_) - 1);
+}
+
+void MeshCoreNode::begin()
+{
+    loadIdentity();
+    loadName();
+    loadChannels();
+    loadContacts();
+
+    BaseChatMesh::begin();
+    sendSelfAdvert(true);
+    lastAdvertMs_ = millis();
+}
+
+void MeshCoreNode::loop()
+{
+    BaseChatMesh::loop();
+
+    uint32_t now = millis();
+    if (now - lastAdvertMs_ >= kAdvertIntervalMs) {
+        sendSelfAdvert(true);
+        lastAdvertMs_ = now;
+    }
+}
+
+void MeshCoreNode::loadIdentity()
+{
+    Preferences prefs;
+    if (prefs.begin("raumata", true)) {
+        size_t len = prefs.getBytesLength("mc_id");
+        if (len == PRV_KEY_SIZE + PUB_KEY_SIZE || len == PRV_KEY_SIZE) {
+            uint8_t buf[PRV_KEY_SIZE + PUB_KEY_SIZE];
+            if (prefs.getBytes("mc_id", buf, len) == len) {
+                self_id.readFrom(buf, len);
+                prefs.end();
+                return;
+            }
+        }
+        prefs.end();
+    }
+
+    self_id = mesh::LocalIdentity(getRNG());
+
+    if (prefs.begin("raumata", false)) {
+        uint8_t buf[PRV_KEY_SIZE + PUB_KEY_SIZE];
+        size_t len = self_id.writeTo(buf, sizeof(buf));
+        prefs.putBytes("mc_id", buf, len);
+        prefs.end();
+    }
+}
+
+void MeshCoreNode::loadName()
+{
+    Preferences prefs;
+    if (prefs.begin("raumata", true)) {
+        String saved = prefs.getString("mc_name", "");
+        prefs.end();
+        if (saved.length() > 0) {
+            hasNameOverride_ = true;
+            strncpy(nodeName_, saved.c_str(), sizeof(nodeName_) - 1);
+            nodeName_[sizeof(nodeName_) - 1] = 0;
+            return;
+        }
+    }
+
+    hasNameOverride_ = false;
+    const char *source = owner.long_name[0] ? owner.long_name : owner.short_name;
+    if (source[0]) {
+        strncpy(nodeName_, source, sizeof(nodeName_) - 1);
+        nodeName_[sizeof(nodeName_) - 1] = 0;
+    }
+}
+
+void MeshCoreNode::loadChannels()
+{
+    bool loaded = false;
+
+    Preferences prefs;
+    if (prefs.begin("raumata", true)) {
+        size_t len = prefs.getBytesLength("mc_ch");
+        if (len == sizeof(ChannelDetails) * MAX_GROUP_CHANNELS) {
+            ChannelDetails channels[MAX_GROUP_CHANNELS];
+            if (prefs.getBytes("mc_ch", channels, len) == len) {
+                for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+                    if (channels[i].name[0]) {
+                        setChannel(i, channels[i]);
+                        loaded = true;
+                    }
+                }
+            }
+        }
+        prefs.end();
+    }
+
+    if (!loaded) {
+        addChannel("Public", RAUMATA_PUBLIC_GROUP_PSK);
+    }
+}
+
+void MeshCoreNode::saveChannels()
+{
+    ChannelDetails channels[MAX_GROUP_CHANNELS];
+    memset(channels, 0, sizeof(channels));
+    for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+        getChannel(i, channels[i]);
+    }
+
+    Preferences prefs;
+    if (prefs.begin("raumata", false)) {
+        prefs.putBytes("mc_ch", channels, sizeof(channels));
+        prefs.end();
+    }
+}
+
+void MeshCoreNode::loadContacts()
+{
+    Preferences prefs;
+    if (!prefs.begin("raumata", true)) {
+        return;
+    }
+
+    size_t len = prefs.getBytesLength("mc_contacts");
+    if (len > 0 && len % sizeof(ContactInfo) == 0 && len <= sizeof(ContactInfo) * MAX_CONTACTS) {
+        size_t count = len / sizeof(ContactInfo);
+        ContactInfo saved[MAX_CONTACTS];
+        if (prefs.getBytes("mc_contacts", saved, len) == len) {
+            for (size_t i = 0; i < count; i++) {
+                if (saved[i].type != 0 && saved[i].name[0] != 0) {
+                    addContact(saved[i]);
+                }
+            }
+        }
+    }
+    prefs.end();
+}
+
+void MeshCoreNode::saveContacts()
+{
+    ContactInfo saved[MAX_CONTACTS];
+    size_t count = 0;
+
+    ContactInfo contact;
+    int slots = getTotalContactSlots();
+    for (int idx = 0; idx < slots && count < MAX_CONTACTS; idx++) {
+        if (!getContactByIdx(idx, contact)) {
+            break;
+        }
+        if (contact.type == 0 || contact.name[0] == 0) {
+            continue;
+        }
+        saved[count++] = contact;
+    }
+
+    Preferences prefs;
+    if (prefs.begin("raumata", false)) {
+        if (count > 0) {
+            prefs.putBytes("mc_contacts", saved, count * sizeof(ContactInfo));
+        } else {
+            prefs.remove("mc_contacts");
+        }
+        prefs.end();
+    }
+}
+
+void MeshCoreNode::saveName()
+{
+    Preferences prefs;
+    if (prefs.begin("raumata", false)) {
+        prefs.putString("mc_name", nodeName_);
+        prefs.end();
+    }
+}
+
+void MeshCoreNode::setNodeName(const char *name)
+{
+    hasNameOverride_ = true;
+    strncpy(nodeName_, name, sizeof(nodeName_) - 1);
+    nodeName_[sizeof(nodeName_) - 1] = 0;
+    saveName();
+}
+
+void MeshCoreNode::syncDefaultName(const char *name)
+{
+    if (hasNameOverride_ || !name || !name[0]) {
+        return;
+    }
+    strncpy(nodeName_, name, sizeof(nodeName_) - 1);
+    nodeName_[sizeof(nodeName_) - 1] = 0;
+}
+
+void MeshCoreNode::sendSelfAdvert(bool flood)
+{
+    mesh::Packet *packet = nullptr;
+    if (localPosition.latitude_i != 0 || localPosition.longitude_i != 0) {
+        double lat = static_cast<double>(localPosition.latitude_i) * 1e-7;
+        double lon = static_cast<double>(localPosition.longitude_i) * 1e-7;
+        packet = createSelfAdvert(nodeName_, lat, lon);
+    } else {
+        packet = createSelfAdvert(nodeName_);
+    }
+
+    if (!packet) {
+        return;
+    }
+    if (flood) {
+        sendFlood(packet);
+    } else {
+        sendZeroHop(packet);
+    }
+}
+
+void MeshCoreNode::recordPendingAck(uint32_t ack, const ContactInfo &recipient)
+{
+    PendingAck &slot = pendingAcks_[nextAckSlot_];
+    slot.ack = ack;
+    slot.sentMs = millis();
+    memcpy(slot.pubKey, recipient.id.pub_key, PUB_KEY_SIZE);
+    slot.active = true;
+    nextAckSlot_ = static_cast<uint8_t>((nextAckSlot_ + 1) % kPendingAckSize);
+}
+
+bool MeshCoreNode::enqueueMessage(const QueuedMessage &message)
+{
+    uint8_t next = static_cast<uint8_t>((msgHead_ + 1) % kMessageQueueSize);
+    if (next == msgTail_) {
+        // Drop the oldest queued message rather than the new one.
+        msgTail_ = static_cast<uint8_t>((msgTail_ + 1) % kMessageQueueSize);
+    }
+    messages_[msgHead_] = message;
+    msgHead_ = next;
+
+    if (writer_) {
+        uint8_t push = PUSH_CODE_MSG_WAITING;
+        writer_(&push, 1);
+    }
+    return true;
+}
+
+bool MeshCoreNode::popMessage(QueuedMessage &message)
+{
+    if (msgTail_ == msgHead_) {
+        return false;
+    }
+    message = messages_[msgTail_];
+    msgTail_ = static_cast<uint8_t>((msgTail_ + 1) % kMessageQueueSize);
+    return true;
+}
+
+void MeshCoreNode::onDiscoveredContact(ContactInfo &contact, bool isNew, uint8_t pathLen, const uint8_t *path)
+{
+    (void)pathLen;
+    (void)path;
+    saveContacts();
+
+    if (!writer_) {
+        return;
+    }
+    if (isNew) {
+        writeContactFrame(PUSH_CODE_NEW_ADVERT, contact);
+    } else {
+        uint8_t push[1 + PUB_KEY_SIZE];
+        push[0] = PUSH_CODE_ADVERT;
+        memcpy(&push[1], contact.id.pub_key, PUB_KEY_SIZE);
+        writer_(push, sizeof(push));
+    }
+}
+
+ContactInfo *MeshCoreNode::processAck(const uint8_t *data)
+{
+    if (!data) {
+        return nullptr;
+    }
+
+    uint32_t ack = 0;
+    memcpy(&ack, data, sizeof(ack));
+
+    for (uint8_t i = 0; i < kPendingAckSize; i++) {
+        PendingAck &slot = pendingAcks_[i];
+        if (slot.active && slot.ack == ack) {
+            slot.active = false;
+            uint32_t tripTimeMs = millis() - slot.sentMs;
+            if (writer_) {
+                uint8_t push[9];
+                push[0] = PUSH_CODE_SEND_CONFIRMED;
+                memcpy(&push[1], &ack, 4);
+                memcpy(&push[5], &tripTimeMs, 4);
+                writer_(push, sizeof(push));
+            }
+            return lookupContactByPubKey(slot.pubKey, PUB_KEY_SIZE);
+        }
+    }
+
+    return checkConnectionsAck(data);
+}
+
+void MeshCoreNode::onContactPathUpdated(const ContactInfo &contact)
+{
+    saveContacts();
+    if (writer_) {
+        uint8_t push[1 + PUB_KEY_SIZE];
+        push[0] = PUSH_CODE_PATH_UPDATED;
+        memcpy(&push[1], contact.id.pub_key, PUB_KEY_SIZE);
+        writer_(push, sizeof(push));
+    }
+}
+
+void MeshCoreNode::onMessageRecv(const ContactInfo &contact, mesh::Packet *packet, uint32_t senderTimestamp,
+                                 const char *text)
+{
+    QueuedMessage message = {};
+    message.type = 1;
+    message.snr4 = static_cast<int8_t>(packet ? packet->getSNR() * 4.0f : 0);
+    message.channel = 0;
+    message.pathLen = packet && packet->isRouteFlood() ? static_cast<uint8_t>(packet->path_len) : 0xFF;
+    message.txtType = RAUMATA_TXT_TYPE_PLAIN;
+    message.timestamp = senderTimestamp;
+    memcpy(message.pubKey, contact.id.pub_key, sizeof(message.pubKey));
+
+    size_t len = strlen(text);
+    if (len > MAX_TEXT_LEN) {
+        len = MAX_TEXT_LEN;
+    }
+    message.textLen = static_cast<uint16_t>(len);
+    memcpy(message.text, text, len);
+    message.text[len] = 0;
+
+    enqueueMessage(message);
+}
