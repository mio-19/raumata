+void MeshCoreNode::writeOK()
+{
+    uint8_t frame = RESP_CODE_OK;
+    writer_(&frame, 1);
+}
+
+void MeshCoreNode::writeError(uint8_t code)
+{
+    uint8_t frame[2] = {RESP_CODE_ERR, code};
+    writer_(frame, sizeof(frame));
+}
+
+void MeshCoreNode::writeSelfInfo()
+{
+    uint8_t frame[MAX_FRAME_SIZE];
+    int i = 0;
+
+    frame[i++] = RESP_CODE_SELF_INFO;
+    frame[i++] = ADV_TYPE_CHAT;
+    int8_t txPower = meshtasticRadio_.getTxPower();
+    frame[i++] = static_cast<uint8_t>(txPower > 0 ? txPower : 20);
+    frame[i++] = 22; // SX1262 max TX power
+
+    memcpy(&frame[i], self_id.pub_key, PUB_KEY_SIZE);
+    i += PUB_KEY_SIZE;
+
+    int32_t lat = localPosition.latitude_i / 10;
+    int32_t lon = localPosition.longitude_i / 10;
+    memcpy(&frame[i], &lat, 4);
+    i += 4;
+    memcpy(&frame[i], &lon, 4);
+    i += 4;
+
+    frame[i++] = 0; // multi acks
+    frame[i++] = (lat != 0 || lon != 0) ? 1 : 0; // advert location policy
+    frame[i++] = 0; // telemetry modes
+    frame[i++] = 0; // manual add contacts
+
+    uint32_t freq = static_cast<uint32_t>(meshtasticRadio_.getFreq() * 1000.0f);
+    uint32_t bw = static_cast<uint32_t>(meshtasticRadio_.getBandwidthKHz() * 1000.0f);
+    memcpy(&frame[i], &freq, 4);
+    i += 4;
+    memcpy(&frame[i], &bw, 4);
+    i += 4;
+    frame[i++] = meshtasticRadio_.getSpreadFactorValue();
+    frame[i++] = meshtasticRadio_.getCodingRateValue();
+
+    size_t nameLen = strlen(nodeName_);
+    if (i + nameLen > sizeof(frame)) {
+        nameLen = sizeof(frame) - i;
+    }
+    memcpy(&frame[i], nodeName_, nameLen);
+    i += nameLen;
+
+    writer_(frame, i);
+}
+
+void MeshCoreNode::writeDeviceInfo()
+{
+    uint8_t frame[MAX_FRAME_SIZE];
+    int i = 0;
+
+    frame[i++] = RESP_CODE_DEVICE_INFO;
+    frame[i++] = FIRMWARE_VER_CODE;
+    frame[i++] = MAX_CONTACTS / 2;
+    frame[i++] = MAX_GROUP_CHANNELS;
+
+    uint32_t pin = 0;
+    memcpy(&frame[i], &pin, 4);
+    i += 4;
+
+    memset(&frame[i], 0, 12);
+    StrHelper::strzcpy(reinterpret_cast<char *>(&frame[i]), FIRMWARE_BUILD_DATE, 12);
+    i += 12;
+
+    StrHelper::strzcpy(reinterpret_cast<char *>(&frame[i]), MANUFACTURER_NAME, 40);
+    i += 40;
+
+    StrHelper::strzcpy(reinterpret_cast<char *>(&frame[i]), FIRMWARE_VERSION, 20);
+    i += 20;
+
+    frame[i++] = 0; // repeat disabled
+    frame[i++] = 0; // path hash mode
+
+    writer_(frame, i);
+}
+
+void MeshCoreNode::writeContactFrame(uint8_t code, const ContactInfo &contact)
+{
+    uint8_t frame[MAX_FRAME_SIZE];
+    int i = 0;
+
+    frame[i++] = code;
+    memcpy(&frame[i], contact.id.pub_key, PUB_KEY_SIZE);
+    i += PUB_KEY_SIZE;
+    frame[i++] = contact.type;
+    frame[i++] = contact.flags;
+    frame[i++] = contact.out_path_len;
+    memcpy(&frame[i], contact.out_path, MAX_PATH_SIZE);
+    i += MAX_PATH_SIZE;
+    StrHelper::strzcpy(reinterpret_cast<char *>(&frame[i]), contact.name, 32);
+    i += 32;
+    memcpy(&frame[i], &contact.last_advert_timestamp, 4);
+    i += 4;
+    memcpy(&frame[i], &contact.gps_lat, 4);
+    i += 4;
+    memcpy(&frame[i], &contact.gps_lon, 4);
+    i += 4;
+    memcpy(&frame[i], &contact.lastmod, 4);
+    i += 4;
+
+    writer_(frame, i);
+}
+
+void MeshCoreNode::writeContacts()
+{
+    uint8_t start[5];
+    start[0] = RESP_CODE_CONTACTS_START;
+    uint32_t count = static_cast<uint32_t>(getNumContacts());
+    memcpy(&start[1], &count, 4);
+    writer_(start, sizeof(start));
+
+    ContactInfo contact;
+    int slots = getTotalContactSlots();
+    uint32_t latestMod = 0;
+    for (int idx = 0; idx < slots; idx++) {
+        if (!getContactByIdx(idx, contact)) {
+            break;
+        }
+        if (contact.type == 0 || contact.name[0] == 0) {
+            continue;
+        }
+        if (contact.lastmod > latestMod) {
+            latestMod = contact.lastmod;
+        }
+        writeContactFrame(RESP_CODE_CONTACT, contact);
+    }
+
+    uint8_t end[5];
+    end[0] = RESP_CODE_END_OF_CONTACTS;
+    memcpy(&end[1], &latestMod, 4);
+    writer_(end, sizeof(end));
+}
+
+void MeshCoreNode::writeChannel(uint8_t idx)
+{
+    ChannelDetails channel;
+    if (!getChannel(idx, channel) || channel.name[0] == 0) {
+        writeError(ERR_CODE_NOT_FOUND);
+        return;
+    }
+
+    uint8_t frame[MAX_FRAME_SIZE];
+    int i = 0;
+    frame[i++] = RESP_CODE_CHANNEL_INFO;
+    frame[i++] = idx;
+    StrHelper::strzcpy(reinterpret_cast<char *>(&frame[i]), channel.name, 32);
+    i += 32;
+    memcpy(&frame[i], channel.channel.secret, 16);
+    i += 16;
+    writer_(frame, i);
+}
+
+void MeshCoreNode::writeNextMessage()
+{
+    QueuedMessage message;
+    if (!popMessage(message)) {
+        uint8_t frame = RESP_CODE_NO_MORE_MESSAGES;
+        writer_(&frame, 1);
+        return;
+    }
+
+    uint8_t frame[MAX_FRAME_SIZE];
+    int i = 0;
+
+    if (message.type == 0) {
+        frame[i++] = RESP_CODE_CHANNEL_MSG_RECV_V3;
+        frame[i++] = static_cast<uint8_t>(message.snr4);
+        frame[i++] = 0;
+        frame[i++] = 0;
+        frame[i++] = message.channel;
+        frame[i++] = message.pathLen;
+        frame[i++] = message.txtType;
+        memcpy(&frame[i], &message.timestamp, 4);
+        i += 4;
+    } else {
+        frame[i++] = RESP_CODE_CONTACT_MSG_RECV_V3;
+        frame[i++] = static_cast<uint8_t>(message.snr4);
+        frame[i++] = 0;
+        frame[i++] = 0;
+        memcpy(&frame[i], message.pubKey, sizeof(message.pubKey));
+        i += sizeof(message.pubKey);
+        frame[i++] = message.pathLen;
+        frame[i++] = message.txtType;
+        memcpy(&frame[i], &message.timestamp, 4);
+        i += 4;
+    }
+
+    size_t textLen = message.textLen;
+    if (i + textLen > sizeof(frame)) {
+        textLen = sizeof(frame) - i;
+    }
+    memcpy(&frame[i], message.text, textLen);
+    i += textLen;
+
+    writer_(frame, i);
+}
+
+void MeshCoreNode::writeStats(uint8_t statsType)
+{
+    uint8_t frame[32];
+    int i = 0;
+    frame[i++] = RESP_CODE_STATS;
+    frame[i++] = statsType;
+
+    switch (statsType) {
+    case STATS_TYPE_CORE: {
+        uint16_t battMv = powerStatus ? static_cast<uint16_t>(powerStatus->getBatteryVoltageMv()) : 0;
+        uint32_t uptimeSec = millis() / 1000;
+        uint16_t errFlags = getErrFlags();
+        uint8_t queueLen = static_cast<uint8_t>((msgHead_ + kMessageQueueSize - msgTail_) % kMessageQueueSize);
+        memcpy(&frame[i], &battMv, 2);
+        i += 2;
+        memcpy(&frame[i], &uptimeSec, 4);
+        i += 4;
+        memcpy(&frame[i], &errFlags, 2);
+        i += 2;
+        frame[i++] = queueLen;
+        break;
+    }
+    case STATS_TYPE_RADIO: {
+        int16_t noiseFloor = static_cast<int16_t>(meshtasticRadio_.getNoiseFloor());
+        int8_t lastRssi = static_cast<int8_t>(meshtasticRadio_.getLastRssi());
+        int8_t lastSnr4 = static_cast<int8_t>(meshtasticRadio_.getLastSnr() * 4.0f);
+        uint32_t txAirSec = getTotalAirTime() / 1000;
+        uint32_t rxAirSec = getReceiveAirTime() / 1000;
+        memcpy(&frame[i], &noiseFloor, 2);
+        i += 2;
+        frame[i++] = static_cast<uint8_t>(lastRssi);
+        frame[i++] = static_cast<uint8_t>(lastSnr4);
+        memcpy(&frame[i], &txAirSec, 4);
+        i += 4;
+        memcpy(&frame[i], &rxAirSec, 4);
+        i += 4;
+        break;
+    }
+    case STATS_TYPE_PACKETS: {
+        uint32_t recvTotal = getNumRecvFlood() + getNumRecvDirect();
+        uint32_t sentTotal = getNumSentFlood() + getNumSentDirect();
+        uint32_t sentFlood = getNumSentFlood();
+        uint32_t sentDirect = getNumSentDirect();
+        uint32_t recvFlood = getNumRecvFlood();
+        uint32_t recvDirect = getNumRecvDirect();
+        memcpy(&frame[i], &recvTotal, 4);
+        i += 4;
+        memcpy(&frame[i], &sentTotal, 4);
+        i += 4;
+        memcpy(&frame[i], &sentFlood, 4);
+        i += 4;
+        memcpy(&frame[i], &sentDirect, 4);
+        i += 4;
+        memcpy(&frame[i], &recvFlood, 4);
+        i += 4;
+        memcpy(&frame[i], &recvDirect, 4);
+        i += 4;
+        break;
+    }
+    default:
+        writeError(ERR_CODE_ILLEGAL_ARG);
+        return;
+    }
+
+    writer_(frame, i);
+}
+
+void MeshCoreNode::handleCompanionFrame(const uint8_t *frame, size_t len)
+{
+    if (len < 1) {
+        return;
+    }
+    handleCommand(frame[0], frame, len);
+}
+
+void MeshCoreNode::handleCommand(uint8_t command, const uint8_t *frame, size_t len)
+{
+    switch (command) {
+    case CMD_DEVICE_QUERY:
+        writeDeviceInfo();
+        break;
+
+    case CMD_APP_START:
+        writeSelfInfo();
+        break;
+
+    case CMD_GET_DEVICE_TIME: {
+        uint8_t reply[5];
+        reply[0] = RESP_CODE_CURR_TIME;
+        uint32_t now = getRTCClock()->getCurrentTime();
+        memcpy(&reply[1], &now, 4);
+        writer_(reply, sizeof(reply));
+        break;
+    }
+
+    case CMD_SET_DEVICE_TIME:
+        if (len >= 5) {
+            uint32_t now;
+            memcpy(&now, &frame[1], 4);
+            getRTCClock()->setCurrentTime(now);
+            writeOK();
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_SEND_SELF_ADVERT:
+        sendSelfAdvert(len >= 2 && frame[1] == 1);
+        writeOK();
+        break;
+
+    case CMD_SET_ADVERT_NAME:
+        if (len >= 2) {
+            char name[32];
+            size_t nameLen = len - 1;
+            if (nameLen > sizeof(name) - 1) {
+                nameLen = sizeof(name) - 1;
+            }
+            memcpy(name, &frame[1], nameLen);
+            name[nameLen] = 0;
+            setNodeName(name);
+            writeOK();
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_GET_CONTACTS:
+        writeContacts();
+        break;
+
+    case CMD_GET_CONTACT_BY_KEY:
+        if (len >= 1 + PUB_KEY_SIZE) {
+            ContactInfo *contact = lookupContactByPubKey(&frame[1], PUB_KEY_SIZE);
+            if (contact) {
+                writeContactFrame(RESP_CODE_CONTACT, *contact);
+            } else {
+                writeError(ERR_CODE_NOT_FOUND);
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_ADD_UPDATE_CONTACT:
+        if (len >= 1 + PUB_KEY_SIZE + 1 + 1 + 1 + MAX_PATH_SIZE + 32 + 4) {
+            ContactInfo contact = {};
+            int i = 1;
+            memcpy(contact.id.pub_key, &frame[i], PUB_KEY_SIZE);
+            i += PUB_KEY_SIZE;
+            contact.type = frame[i++];
+            contact.flags = frame[i++];
+            contact.out_path_len = frame[i++];
+            memcpy(contact.out_path, &frame[i], MAX_PATH_SIZE);
+            i += MAX_PATH_SIZE;
+            StrHelper::strzcpy(contact.name, reinterpret_cast<const char *>(&frame[i]), 32);
+            i += 32;
+            memcpy(&contact.last_advert_timestamp, &frame[i], 4);
+            i += 4;
+            if (len >= static_cast<size_t>(i + 8)) {
+                memcpy(&contact.gps_lat, &frame[i], 4);
+                i += 4;
+                memcpy(&contact.gps_lon, &frame[i], 4);
+                i += 4;
+            }
+            contact.lastmod = getRTCClock()->getCurrentTime();
+
+            ContactInfo *existing = lookupContactByPubKey(contact.id.pub_key, PUB_KEY_SIZE);
+            if (existing) {
+                *existing = contact;
+                saveContacts();
+                writeOK();
+            } else if (addContact(contact)) {
+                saveContacts();
+                writeOK();
+            } else {
+                writeError(ERR_CODE_TABLE_FULL);
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_REMOVE_CONTACT:
+        if (len >= 1 + PUB_KEY_SIZE) {
+            ContactInfo *contact = lookupContactByPubKey(&frame[1], PUB_KEY_SIZE);
+            if (contact && removeContact(*contact)) {
+                saveContacts();
+                writeOK();
+            } else {
+                writeError(ERR_CODE_NOT_FOUND);
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_RESET_PATH:
+        if (len >= 1 + PUB_KEY_SIZE) {
+            ContactInfo *contact = lookupContactByPubKey(&frame[1], PUB_KEY_SIZE);
+            if (contact) {
+                resetPathTo(*contact);
+                saveContacts();
+                writeOK();
+            } else {
+                writeError(ERR_CODE_NOT_FOUND);
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_EXPORT_CONTACT:
+        if (len == 1) {
+            mesh::Packet *pkt = createSelfAdvert(nodeName_);
+            if (pkt) {
+                uint8_t reply[1 + MAX_TRANS_UNIT];
+                reply[0] = RESP_CODE_EXPORT_CONTACT;
+                uint8_t n = pkt->writeTo(&reply[1]);
+                releasePacket(pkt);
+                writer_(reply, 1 + n);
+            } else {
+                writeError(ERR_CODE_TABLE_FULL);
+            }
+        } else if (len >= 1 + PUB_KEY_SIZE) {
+            ContactInfo *contact = lookupContactByPubKey(&frame[1], PUB_KEY_SIZE);
+            if (contact) {
+                uint8_t reply[1 + MAX_TRANS_UNIT];
+                reply[0] = RESP_CODE_EXPORT_CONTACT;
+                uint8_t n = exportContact(*contact, &reply[1]);
+                if (n > 0) {
+                    writer_(reply, 1 + n);
+                } else {
+                    writeError(ERR_CODE_BAD_STATE);
+                }
+            } else {
+                writeError(ERR_CODE_NOT_FOUND);
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_IMPORT_CONTACT:
+        if (len > 1 && importContact(&frame[1], static_cast<uint8_t>(len - 1))) {
+            saveContacts();
+            writeOK();
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_GET_CHANNEL:
+        if (len >= 2) {
+            writeChannel(frame[1]);
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_SET_CHANNEL:
+        if (len >= 2 + 32 + 16) {
+            uint8_t idx = frame[1];
+            ChannelDetails channel = {};
+            StrHelper::strzcpy(channel.name, reinterpret_cast<const char *>(&frame[2]), 32);
+            memcpy(channel.channel.secret, &frame[2 + 32], 16);
+            if (setChannel(idx, channel)) {
+                saveChannels();
+                writeOK();
+            } else {
+                writeError(ERR_CODE_NOT_FOUND);
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_SEND_CHANNEL_TXT_MSG:
+        if (len >= 7) {
+            uint8_t channelIdx = frame[2];
+            uint32_t timestamp;
+            memcpy(&timestamp, &frame[3], 4);
+
+            char text[MAX_TEXT_LEN + 1];
+            size_t textLen = len - 7;
+            if (textLen > MAX_TEXT_LEN) {
+                textLen = MAX_TEXT_LEN;
+            }
+            memcpy(text, &frame[7], textLen);
+            text[textLen] = 0;
+
+            ChannelDetails channel;
+            if (getChannel(channelIdx, channel) && channel.name[0]) {
+                if (sendGroupMessage(timestamp, channel.channel, nodeName_, text, textLen)) {
+                    writeOK();
+                } else {
+                    writeError(ERR_CODE_TABLE_FULL);
+                }
+            } else {
+                writeError(ERR_CODE_NOT_FOUND);
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_SEND_TXT_MSG:
+        if (len >= 14) {
+            uint8_t attempt = frame[2];
+            uint32_t timestamp;
+            memcpy(&timestamp, &frame[3], 4);
+            ContactInfo *contact = lookupContactByPubKey(&frame[7], 6);
+            if (!contact) {
+                writeError(ERR_CODE_NOT_FOUND);
+                break;
+            }
+
+            char text[MAX_TEXT_LEN + 1];
+            size_t textLen = len - 13;
+            if (textLen > MAX_TEXT_LEN) {
+                textLen = MAX_TEXT_LEN;
+            }
+            memcpy(text, &frame[13], textLen);
+            text[textLen] = 0;
+
+            uint32_t expectedAck = 0;
+            uint32_t estTimeout = 0;
+            int result = sendMessage(*contact, timestamp, attempt, text, expectedAck, estTimeout);
+            if (result == MSG_SEND_FAILED) {
+                writeError(ERR_CODE_TABLE_FULL);
+            } else {
+                recordPendingAck(expectedAck, *contact);
+                uint8_t reply[10];
+                reply[0] = RESP_CODE_SENT;
+                reply[1] = result == MSG_SEND_SENT_FLOOD ? 1 : 0;
+                memcpy(&reply[2], &expectedAck, 4);
+                memcpy(&reply[6], &estTimeout, 4);
+                writer_(reply, sizeof(reply));
+            }
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_SYNC_NEXT_MESSAGE:
+        writeNextMessage();
+        break;
+
+    case CMD_GET_BATT_AND_STORAGE: {
+        uint8_t reply[11];
+        int i = 0;
+        reply[i++] = RESP_CODE_BATT_AND_STORAGE;
+        uint16_t battery = powerStatus ? static_cast<uint16_t>(powerStatus->getBatteryVoltageMv()) : 0;
+        uint32_t used = static_cast<uint32_t>(FSCom.usedBytes() / 1024);
+        uint32_t total = static_cast<uint32_t>(FSCom.totalBytes() / 1024);
+        memcpy(&reply[i], &battery, 2);
+        i += 2;
+        memcpy(&reply[i], &used, 4);
+        i += 4;
+        memcpy(&reply[i], &total, 4);
+        i += 4;
+        writer_(reply, i);
+        break;
+    }
+
+    case CMD_GET_STATS:
+        writeStats(len >= 2 ? frame[1] : STATS_TYPE_CORE);
+        break;
+
+    case CMD_REBOOT:
+        if (len >= 7 && memcmp(&frame[1], "reboot", 6) == 0) {
+            ESP.restart();
+        } else {
+            writeError(ERR_CODE_ILLEGAL_ARG);
+        }
+        break;
+
+    case CMD_SET_RADIO_PARAMS:
+    case CMD_SET_RADIO_TX_POWER:
+        // Replaced by shared PHY profile handling in the PHY series patch.
+        writeError(ERR_CODE_UNSUPPORTED_CMD);
+        break;
+
+    default:
+        writeError(ERR_CODE_UNSUPPORTED_CMD);
+        break;
+    }
+}
+
+} // namespace raumata
+
+#endif // RAUMATA_DUAL_PROTOCOL
