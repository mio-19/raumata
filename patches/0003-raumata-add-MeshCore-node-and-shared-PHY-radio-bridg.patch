+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+#include "Mesh.h"
+#include "mesh/RadioInterface.h"
+
+namespace raumata {
+
+/**
+ * mesh::Radio implementation that shares the Meshtastic LoRa radio.
+ *
+ * MeshCore frames are distinguished from Meshtastic frames by a 4-byte
+ * transport tag prepended on air.  The tag is stripped before the frame is
+ * handed to MeshCore, so MeshCore's own packet format is unchanged.
+ */
+class MeshCoreRadio : public mesh::Radio, public RawPacketHandler
+{
+  public:
+    static constexpr uint8_t kMagic[4] = {'R', 'A', 'U', 'M'};
+    static constexpr uint8_t kMagicLen = sizeof(kMagic);
+
+    explicit MeshCoreRadio(RadioInterface &radio);
+
+    // mesh::Radio
+    void begin() override;
+    int recvRaw(uint8_t *bytes, int sz) override;
+    uint32_t getEstAirtimeFor(int len_bytes) override;
+    float packetScore(float snr, int packet_len) override;
+    bool startSendRaw(const uint8_t *bytes, int len) override;
+    bool isSendComplete() override;
+    void onSendFinished() override;
+    bool isInRecvMode() const override;
+    bool isReceiving() override;
+    void loop() override;
+    int getNoiseFloor() const override;
+    float getLastRSSI() const override;
+    float getLastSNR() const override;
+
+    // RawPacketHandler
+    bool handleRawPacket(const uint8_t *data, size_t len, float snr, float rssi) override;
+
+  private:
+    static constexpr uint8_t kQueueSize = 4;
+
+    struct Frame {
+        uint16_t len;
+        float snr;
+        float rssi;
+        uint8_t data[MAX_TRANS_UNIT];
+    };
+
+    RadioInterface &radio_;
+    Frame queue_[kQueueSize];
+    std::atomic<uint8_t> head_{0};
+    std::atomic<uint8_t> tail_{0};
+    volatile float lastSnr_ = 0;
+    volatile float lastRssi_ = 0;
+
+    // MeshCore's Dispatcher expects startSendRaw() to be non-blocking.  If the
+    // Meshtastic stack currently owns the radio, keep the frame here and retry
+    // from loop() instead of dropping it.
+    uint8_t pending_[kMagicLen + MAX_TRANS_UNIT];
+    uint16_t pendingLen_ = 0;
+    bool sending_ = false;
+
+    bool tryStartPending();
+};
+
+} // namespace raumata
