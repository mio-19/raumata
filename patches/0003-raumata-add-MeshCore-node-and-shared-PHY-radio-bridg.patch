+#pragma once
+
+#include <Arduino.h>
+#include <Preferences.h>
+#include <functional>
+
+#include <helpers/BaseChatMesh.h>
+
+#include "mesh/RadioInterface.h"
+
+namespace raumata {
+
+class MeshCoreNode : public BaseChatMesh
+{
+  public:
+    using FrameWriter = std::function<void(const uint8_t *frame, size_t len)>;
+
+    MeshCoreNode(mesh::Radio &radio, mesh::MillisecondClock &ms, mesh::RNG &rng, mesh::RTCClock &rtc,
+                 mesh::PacketManager &mgr, mesh::MeshTables &tables, RadioInterface &meshtasticRadio,
+                 FrameWriter writer);
+
+    void begin();
+    void loop();
+
+    void handleCompanionFrame(const uint8_t *frame, size_t len);
+    const char *nodeName() const { return nodeName_; }
+    bool hasNameOverride() const { return hasNameOverride_; }
+    void setNodeName(const char *name);
+    void syncDefaultName(const char *name);
+    const mesh::LocalIdentity &identity() const { return self_id; }
+    void sendSelfAdvert(bool flood);
+
+  protected:
+    // BaseChatMesh hooks
+    void onDiscoveredContact(ContactInfo &contact, bool isNew, uint8_t pathLen, const uint8_t *path) override;
+    ContactInfo *processAck(const uint8_t *data) override;
+    void onContactPathUpdated(const ContactInfo &contact) override;
+    void onMessageRecv(const ContactInfo &contact, mesh::Packet *pkt, uint32_t senderTimestamp,
+                       const char *text) override;
+    void onCommandDataRecv(const ContactInfo &contact, mesh::Packet *pkt, uint32_t senderTimestamp,
+                           const char *text) override;
+    void onCLICommandRecv(const ContactInfo &contact, mesh::Packet *pkt, uint32_t senderTimestamp,
+                          const char *text, char *reply) override;
+    void onSignedMessageRecv(const ContactInfo &contact, mesh::Packet *pkt, uint32_t senderTimestamp,
+                             const uint8_t *senderPrefix, const char *text) override;
+    uint32_t calcFloodTimeoutMillisFor(uint32_t pktAirtimeMillis) const override;
+    uint32_t calcDirectTimeoutMillisFor(uint32_t pktAirtimeMillis, uint8_t pathLen) const override;
+    void onSendTimeout() override;
+    void onChannelMessageRecv(const mesh::GroupChannel &channel, mesh::Packet *pkt, uint32_t timestamp,
+                              const char *text) override;
+    uint8_t onContactRequest(const ContactInfo &contact, uint32_t senderTimestamp, const uint8_t *data, uint8_t len,
+                             uint8_t *reply) override;
+    void onContactResponse(const ContactInfo &contact, const uint8_t *data, uint8_t len) override;
+
+  private:
+    static constexpr uint8_t kMessageQueueSize = 8;
+    static constexpr uint8_t kPendingAckSize = 8;
+    static constexpr uint32_t kAdvertIntervalMs = 15UL * 60UL * 1000UL;
+
+    struct QueuedMessage {
+        uint8_t type; // 0 = channel, 1 = contact
+        int8_t snr4;
+        uint8_t channel;
+        uint8_t pathLen;
+        uint8_t txtType;
+        uint32_t timestamp;
+        uint8_t pubKey[6];
+        uint16_t textLen;
+        char text[MAX_TEXT_LEN + 1];
+    };
+
+    struct PendingAck {
+        uint32_t ack;
+        uint32_t sentMs;
+        uint8_t pubKey[PUB_KEY_SIZE];
+        bool active;
+    };
+
+    RadioInterface &meshtasticRadio_;
+    FrameWriter writer_;
+    char nodeName_[32];
+    bool hasNameOverride_ = false;
+    QueuedMessage messages_[kMessageQueueSize];
+    uint8_t msgHead_ = 0;
+    uint8_t msgTail_ = 0;
+    PendingAck pendingAcks_[kPendingAckSize] = {};
+    uint8_t nextAckSlot_ = 0;
+    uint32_t lastAdvertMs_ = 0;
+
+    void loadIdentity();
+    void loadName();
+    void loadChannels();
+    void saveChannels();
+    void loadContacts();
+    void saveContacts();
+    void saveName();
+
+    void recordPendingAck(uint32_t ack, const ContactInfo &recipient);
+    bool enqueueMessage(const QueuedMessage &message);
+    bool popMessage(QueuedMessage &message);
+
+    void writeOK();
+    void writeError(uint8_t code);
+    void writeSelfInfo();
+    void writeDeviceInfo();
+    void writeContacts();
+    void writeChannel(uint8_t idx);
+    void writeNextMessage();
+    void writeStats(uint8_t statsType);
+    void writeContactFrame(uint8_t code, const ContactInfo &contact);
+
+    void handleCommand(uint8_t command, const uint8_t *frame, size_t len);
+};
+
+} // namespace raumata
diff --git a/src/raumata/MeshCoreRadio.cpp b/src/raumata/MeshCoreRadio.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f342c8014ed77644d9dc983f28428cff8c91d1e0
