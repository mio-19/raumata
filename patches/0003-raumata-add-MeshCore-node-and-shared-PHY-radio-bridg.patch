+++ b/src/raumata/MeshCoreRadio.cpp
@@ -0,0 +1,161 @@
+#ifdef RAUMATA_DUAL_PROTOCOL
+#include "MeshCoreRadio.h"
+
+#include <cstring>
+
+namespace raumata {
+
+MeshCoreRadio::MeshCoreRadio(RadioInterface &radio) : radio_(radio) {}
+
+void MeshCoreRadio::begin()
+{
+    radio_.setRawPacketHandler(this);
+}
+
+bool MeshCoreRadio::handleRawPacket(const uint8_t *data, size_t len, float snr, float rssi)
+{
+    if (len < kMagicLen + 1 || memcmp(data, kMagic, kMagicLen) != 0) {
+        return false;
+    }
+
+    uint16_t payloadLen = static_cast<uint16_t>(len - kMagicLen);
+    if (payloadLen > MAX_TRANS_UNIT) {
+        return true; // ours, but malformed; consume so Meshtastic never sees it
+    }
+
+    uint8_t head = head_.load(std::memory_order_relaxed);
+    uint8_t next = static_cast<uint8_t>((head + 1) % kQueueSize);
+    if (next == tail_.load(std::memory_order_acquire)) {
+        return true; // queue full: drop the frame
+    }
+
+    Frame &frame = queue_[head];
+    frame.len = payloadLen;
+    frame.snr = snr;
+    frame.rssi = rssi;
+    memcpy(frame.data, data + kMagicLen, payloadLen);
+    head_.store(next, std::memory_order_release);
+    return true;
+}
+
+int MeshCoreRadio::recvRaw(uint8_t *bytes, int sz)
+{
+    uint8_t tail = tail_.load(std::memory_order_relaxed);
+    if (tail == head_.load(std::memory_order_acquire)) {
+        return 0;
+    }
+
+    Frame &frame = queue_[tail];
+    int copyLen = frame.len < static_cast<uint16_t>(sz) ? frame.len : sz;
+    memcpy(bytes, frame.data, copyLen);
+    lastSnr_ = frame.snr;
+    lastRssi_ = frame.rssi;
+    tail_.store(static_cast<uint8_t>((tail + 1) % kQueueSize), std::memory_order_release);
+    return copyLen;
+}
+
+uint32_t MeshCoreRadio::getEstAirtimeFor(int len_bytes)
+{
+    return radio_.getPacketTime(static_cast<uint32_t>(len_bytes) + kMagicLen, false);
+}
+
+float MeshCoreRadio::packetScore(float snr, int packet_len)
+{
+    float snrScore = (snr + 20.0f) / 20.0f;
+    if (snrScore < 0.0f) {
+        snrScore = 0.0f;
+    } else if (snrScore > 1.0f) {
+        snrScore = 1.0f;
+    }
+
+    float lengthScore = 1.0f - (static_cast<float>(packet_len) / 256.0f);
+    if (lengthScore < 0.0f) {
+        lengthScore = 0.0f;
+    }
+    return snrScore * lengthScore;
+}
+
+bool MeshCoreRadio::startSendRaw(const uint8_t *bytes, int len)
+{
+    if (len <= 0 || len > MAX_TRANS_UNIT || pendingLen_ != 0 || sending_) {
+        return false;
+    }
+
+    pendingLen_ = static_cast<uint16_t>(kMagicLen + len);
+    memcpy(pending_, kMagic, kMagicLen);
+    memcpy(pending_ + kMagicLen, bytes, len);
+
+    if (radio_.rawTransmit(pending_, pendingLen_)) {
+        pendingLen_ = 0;
+        sending_ = true;
+    } else {
+        // The Meshtastic stack is using the radio.  Keep the frame and let
+        // loop() retry; report success so MeshCore does not free it.
+        sending_ = false;
+    }
+
+    return true;
+}
+
+bool MeshCoreRadio::tryStartPending()
+{
+    if (pendingLen_ == 0 || sending_) {
+        return false;
+    }
+    if (!radio_.rawTransmit(pending_, pendingLen_)) {
+        return false;
+    }
+    pendingLen_ = 0;
+    sending_ = true;
+    return true;
+}
+
+bool MeshCoreRadio::isSendComplete()
+{
+    if (pendingLen_ != 0) {
+        return false;
+    }
+    return sending_ && radio_.rawTransmitDone();
+}
+
+void MeshCoreRadio::onSendFinished()
+{
+    radio_.rawTransmitFinished();
+    sending_ = false;
+}
+
+bool MeshCoreRadio::isInRecvMode() const
+{
+    return !sending_ && pendingLen_ == 0 && !radio_.rawTransmitActive();
+}
+
+bool MeshCoreRadio::isReceiving()
+{
+    // MeshCore's Dispatcher::checkSend() checks isReceiving() to detect
+    // channel activity / busy state before transmitting.
+    return sending_ || pendingLen_ != 0 || radio_.isChannelBusy();
+}
+
+void MeshCoreRadio::loop()
+{
+    tryStartPending();
+}
+
+int MeshCoreRadio::getNoiseFloor() const
+{
+    return radio_.getNoiseFloor();
+}
+
+float MeshCoreRadio::getLastRSSI() const
+{
+    return lastRssi_;
+}
+
+float MeshCoreRadio::getLastSNR() const
+{
+    return lastSnr_;
+}
+
+} // namespace raumata
